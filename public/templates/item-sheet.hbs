<div class="sr2e-sheet">
  <header class="sr2e-header">
    <img src="{{item.img}}" alt="" width="48" height="48" data-edit="img">
    <input type="text" name="name" value="{{item.name}}" placeholder="{{sr2eT "SR2E.UI.name"}}">
    <button type="button" data-action="postItem" title="{{sr2eT "SR2E.UI.postThisItemToChat"}}"><i class="fa-solid fa-comment"></i></button>
  </header>
  {{#if templates.length}}
  <div class="sr2e-row sr2e-template">
    <label title="{{sr2eT "SR2E.UI.fillInThisItemFromA"}}">{{sr2eT "SR2E.UI.template"}} <select data-template-select>
      <option value="">{{sr2eT "SR2E.UI.pickOne"}}</option>
      {{#each templates}}<option value="{{id}}">{{name}}{{#if world}} {{sr2eT "SR2E.UI.world"}}{{/if}}</option>{{/each}}
    </select></label>
    <button type="button" data-action="applyTemplate">{{sr2eT "SR2E.UI.fillIn"}}</button>
    {{#if isGM}}<button type="button" class="sr2e-gm-only" data-action="saveTemplate" title="{{sr2eT "SR2E.UI.saveThisItemSSettingsAs"}}">{{sr2eT "SR2E.UI.saveAsTemplate"}}</button>
    <a data-action="deleteTemplate" title="{{sr2eT "SR2E.UI.deleteThePickedWorldTemplate"}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
  </div>
  {{else}}{{#if isGM}}<div class="sr2e-row sr2e-template sr2e-gm-only"><button type="button" data-action="saveTemplate" title="{{sr2eT "SR2E.UI.saveThisItemSSettingsAs"}}">{{sr2eT "SR2E.UI.saveAsTemplate"}}</button></div>{{/if}}{{/if}}
  {{#if itemWarnings.length}}<ul class="sr2e-warnings">{{#each itemWarnings}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
  {{#if carriedOn}}<div class="sr2e-row sr2e-carried-row">
    <label title="{{sr2eT "SR2E.UI.carriedHint"}}">{{sr2eT "SR2E.UI.carried"}} <input type="checkbox" name="system.carried" {{checked system.carried}}></label>
    {{#if leftBehind}}<span class="sr2e-warn">{{sr2eT "SR2E.UI.leftBehindHint"}}</span>{{/if}}
  </div>{{/if}}
  {{#if fromDescription}}<div class="sr2e-row sr2e-from-description"><span class="hint">{{fromDescription}}</span> <button type="button" data-action="undoDescription" title="{{sr2eT "SR2E.UI.undoDescriptionHint"}}"><i class="fa-solid fa-rotate-left"></i> {{sr2eT "SR2E.UI.undo"}}</button></div>{{/if}}

  {{#if (eq type "skill")}}
  <h3 class="sr2e-subhead" data-heading="Rating and kind">{{sr2eT "SR2E.UI.ratingAndKind"}}</h3>
  <div class="sr2e-row">
    <label>{{sr2eT "SR2E.UI.rating"}} <input type="number" name="system.rating" value="{{system.rating}}" min="0"></label>
    <label>{{sr2eT "SR2E.UI.linkedAttribute"}}
      <select name="system.attribute">
        {{selectOptions attributeChoices selected=system.attribute valueAttr="key" labelAttr="label"}}
      </select>
    </label>
    <label>{{sr2eT "SR2E.UI.specialization3"}} <input type="text" name="system.specialization" value="{{system.specialization}}"></label>
    <label>{{sr2eT "SR2E.UI.specRating0None"}} <input type="number" name="system.specializationRating" value="{{system.specializationRating}}" min="0"></label>
    <label title="{{sr2eT "SR2E.UI.setsTheKarmaCostOfRaising"}}">{{sr2eT "SR2E.UI.kind"}} <select name="system.kind">{{selectOptions skillKinds selected=system.kind valueAttr="key" labelAttr="label"}}</select></label>
    {{#if (eq system.kind "language")}}<label title="{{sr2eT "SR2E.UI.theCharacterSNativeTongueFree"}}">{{sr2eT "SR2E.UI.native2"}} <input type="checkbox" name="system.native" {{checked system.native}}></label>{{/if}}
  </div>
  <h3 class="sr2e-subhead" data-heading="Concentration">{{sr2eT "SR2E.UI.concentration"}}</h3>
  <div class="sr2e-row">
    <label title="{{sr2eT "SR2E.UI.betweenTheSkillAndItsSpecialization"}}">{{sr2eT "SR2E.UI.concentration"}} <input type="text" name="system.concentration" value="{{system.concentration}}"></label>
    <label>{{sr2eT "SR2E.UI.concRating0None"}} <input type="number" name="system.concentrationRating" value="{{system.concentrationRating}}" min="0"></label>
    <label title="{{sr2eT "SR2E.UI.replacesUnarmedCombatForUnarmedAttacks"}}">{{sr2eT "SR2E.UI.martialArtUnarmedStyle"}} <input type="checkbox" name="system.martial.enabled" {{checked system.martial.enabled}}></label>
  </div>
  {{#if system.martial.enabled}}
  <h3 class="sr2e-subhead" data-heading="Martial art">{{sr2eT "SR2E.UI.martialArt2"}}</h3>
  <div class="sr2e-row">
    <label>{{sr2eT "SR2E.UI.power2"}} <input type="number" name="system.martial.power" value="{{system.martial.power}}"></label>
    <label title="{{sr2eT "SR2E.UI.damageLevelsUp"}}">{{sr2eT "SR2E.UI.stageUp"}} <input type="number" name="system.martial.stage" value="{{system.martial.stage}}" min="0"></label>
    <label>{{sr2eT "SR2E.UI.reach2"}} <input type="number" name="system.martial.reach" value="{{system.martial.reach}}"></label>
    <label title="{{sr2eT "SR2E.UI.extraDiceWhenDefendingUnarmed"}}">{{sr2eT "SR2E.UI.defenseDice"}} <input type="number" name="system.martial.defense" value="{{system.martial.defense}}" min="0"></label>
  </div>
  {{/if}}
  {{/if}}

  {{#if (eq type "weapon")}}
  <div class="sr2e-row sr2e-layout">
    <label>{{sr2eT "SR2E.UI.kind"}} <select data-weapon-layout>{{selectOptions layoutChoices selected=layout valueAttr="key" labelAttr="label"}}</select></label>
    <a data-action="toggleAllFields">{{#if showAll}}{{sr2eT "SR2E.UI.showOnlyThisKindSFields"}}{{else}}{{sr2eT "SR2E.UI.showEveryField"}}{{/if}}</a>
  </div>
  <h3 class="sr2e-subhead" data-help="item-sheet" data-heading="Attack">{{sr2eT "SR2E.UI.attack__heading"}}</h3>
  <div class="sr2e-row">
    <label>{{sr2eT "SR2E.UI.attackSkill"}} <input type="text" name="system.skill" value="{{system.skill}}"></label>
    <label>{{sr2eT "SR2E.UI.specialization3"}} <input type="text" name="system.specialization" value="{{system.specialization}}" placeholder="{{sr2eT "SR2E.UI.eGPistols"}}"></label>
    {{#if sec.all}}<label>{{sr2eT "SR2E.UI.melee3"}} <input type="checkbox" name="system.melee" {{checked system.melee}}></label>{{/if}}
    {{#if sec.melee}}<label>{{sr2eT "SR2E.UI.reach3"}} <input type="number" name="system.reach" value="{{system.reach}}" min="0"></label>{{/if}}
  </div>
  <h3 class="sr2e-subhead" data-help="item-sheet" data-heading="Damage">{{sr2eT "SR2E.UI.damage"}}</h3>
  <div class="sr2e-row">
    <label>{{sr2eT "SR2E.UI.power3"}} <input type="number" name="system.damagePower" value="{{system.damagePower}}" min="0"></label>
    <label>{{sr2eT "SR2E.UI.level2"}}
      <select name="system.damageLevel">
        {{selectOptions damageLevels selected=system.damageLevel valueAttr="key" labelAttr="label"}}
      </select>
    </label>
    <label>{{sr2eT "SR2E.UI.type"}}
      <select name="system.damageType">
        {{selectOptions damageTypes selected=system.damageType valueAttr="key" labelAttr="label"}}
      </select>
    </label>
    {{#if sec.strength}}<label title="{{sr2eT "SR2E.UI.powerStrengthThePowerAboveE"}}">{{sr2eT "SR2E.UI.powerFromStrength"}} <input type="checkbox" name="system.strengthPower" {{checked system.strengthPower}}></label>
    <label title="{{sr2eT "SR2E.UI.bowsTheHighestStrengthTheWeapon"}}">{{sr2eT "SR2E.UI.strengthCap"}} <input type="number" name="system.strengthCap" value="{{system.strengthCap}}" min="0"></label>{{/if}}
    <label title="{{sr2eT "SR2E.UI.taserOrStunBatonStunDamage"}}">{{sr2eT "SR2E.UI.stunWeapon"}} <input type="checkbox" name="system.stunWeapon" {{checked system.stunWeapon}}></label>
    <label>{{sr2eT "SR2E.UI.magical"}} <input type="checkbox" name="system.magical" {{checked system.magical}}></label>
    {{#if system.melee}}<label title="{{sr2eT "SR2E.UI.aMonofilamentWhipABadMiss"}}">{{sr2eT "SR2E.UI.canHitItsWielder"}} <input type="checkbox" name="system.selfHit" {{checked system.selfHit}}></label>{{/if}}
    {{#if system.stunWeapon}}{{#if system.melee}}<label title="{{sr2eT "SR2E.UI.aStunBatonSCharges0"}}">{{sr2eT "SR2E.UI.charges"}} <input type="number" name="system.ammo" value="{{system.ammo}}" min="0"> / <input type="number" name="system.ammoMax" value="{{system.ammoMax}}" min="0"></label>{{/if}}{{/if}}
    <label title="{{sr2eT "SR2E.UI.whatItIsMadeOfOr"}}">{{sr2eT "SR2E.UI.material"}} <input type="text" name="system.material" value="{{system.material}}" placeholder="{{sr2eT "SR2E.UI.eGSilver"}}"></label>
  </div>
  {{#if sec.gun}}
  <h3 class="sr2e-subhead" data-heading="Firearm">{{sr2eT "SR2E.UI.firearm"}}</h3>
  <div class="sr2e-row">
    <label>{{sr2eT "SR2E.UI.firingModes"}} <input type="text" name="system.modes" value="{{system.modes}}" placeholder="{{sr2eT "SR2E.UI.saBfFa"}}"></label>
    <label>{{sr2eT "SR2E.UI.recoilComp"}} <input type="number" name="system.recoilComp" value="{{system.recoilComp}}" min="0"></label>
    <label>{{sr2eT "SR2E.UI.heavyDoubleRecoil"}} <input type="checkbox" name="system.heavy" {{checked system.heavy}}></label>
    <label title="{{sr2eT "SR2E.UI.gyroMountRatingCancelsRecoilThen"}}">{{sr2eT "SR2E.UI.gyro"}} <input type="number" name="system.gyro" value="{{system.gyro}}" min="0"></label>
    <label>{{sr2eT "SR2E.UI.smartgun"}} <input type="checkbox" name="system.smartgun" {{checked system.smartgun}}></label>
    <label title="{{sr2eT "SR2E.UI.silencerSsSaOnlySuppressorAny"}}">{{sr2eT "SR2E.UI.muzzle"}} <select name="system.muzzle">{{selectOptions muzzleChoices selected=system.muzzle valueAttr="key" labelAttr="label"}}</select></label>
  </div>
  <h3 class="sr2e-subhead" data-heading="Accessories">{{sr2eT "SR2E.UI.accessories"}}</h3>
  <div class="sr2e-row">
    <label>{{sr2eT "SR2E.UI.laserSight"}} <input type="checkbox" name="system.laserSight" {{checked system.laserSight}}></label>
    <label>{{sr2eT "SR2E.UI.imagingScopeMagnification"}} <input type="number" name="system.scope" value="{{system.scope}}" min="0" max="3"></label>
    <label>{{sr2eT "SR2E.UI.scopeVision"}} <select name="system.scopeVision">{{selectOptions scopeVisionChoices selected=system.scopeVision valueAttr="key" labelAttr="label"}}</select></label>
    <label>{{sr2eT "SR2E.UI.shockPad"}} <input type="checkbox" name="system.shockPad" {{checked system.shockPad}}></label>
    <label>{{sr2eT "SR2E.UI.bipodTripod"}} <select name="system.support">{{selectOptions supportChoices selected=system.support valueAttr="key" labelAttr="label"}}</select></label>
    {{#unless (eq system.support "none")}}<label>{{sr2eT "SR2E.UI.setUp3"}} <input type="checkbox" name="system.supportSetUp" {{checked system.supportSetUp}}></label>{{/unless}}
  </div>
  {{/if}}
  {{#if sec.ammo}}
  <h3 class="sr2e-subhead" data-heading="Ammunition">{{sr2eT "SR2E.UI.ammunition"}}</h3>
  <div class="sr2e-row">
    <label>{{sr2eT "SR2E.UI.ammunition"}}
      <select name="system.ammoType">
        {{selectOptions ammoChoices selected=system.ammoType valueAttr="key" labelAttr="label"}}
      </select>
    </label>
    <label>{{sr2eT "SR2E.UI.ammo"}} <input type="number" name="system.ammo" value="{{system.ammo}}" min="0"></label>
    <label>{{sr2eT "SR2E.UI.capacity0Untracked"}} <input type="number" name="system.ammoMax" value="{{system.ammoMax}}" min="0"></label>
  </div>
  {{/if}}
  {{#if sec.blast}}
  <h3 class="sr2e-subhead" data-heading="Blast">{{sr2eT "SR2E.UI.blast"}}</h3>
  <div class="sr2e-row">
    {{#if sec.all}}<label>{{sr2eT "SR2E.UI.blastGrenade"}} <input type="checkbox" name="system.blast" {{checked system.blast}}></label>{{/if}}
    <label>{{sr2eT "SR2E.UI.blastKind"}}
      <select name="system.blastKind">{{selectOptions grenadeChoices selected=system.blastKind valueAttr="key" labelAttr="label"}}</select>
    </label>
    <label>{{sr2eT "SR2E.UI.powerLostPerMetre"}} <input type="number" name="system.blastPerMetre" value="{{system.blastPerMetre}}" min="0" step="0.5"></label>
    <label>{{sr2eT "SR2E.UI.fuse"}} <select name="system.fuse">{{selectOptions fuseChoices selected=system.fuse valueAttr="key" labelAttr="label"}}</select></label>
    <label>{{sr2eT "SR2E.UI.smartGrenade"}} <input type="checkbox" name="system.smartGrenade" {{checked system.smartGrenade}}></label>
    <label title="{{sr2eT "SR2E.UI.grenadeLaunchersCloserThanThisIt"}}">{{sr2eT "SR2E.UI.minArmingRangeM"}} <input type="number" name="system.minRange" value="{{system.minRange}}" min="0"></label>
    <label title="{{sr2eT "SR2E.UI.mortarsAndLobbingLaunchersFireAt"}}">{{sr2eT "SR2E.UI.indirectFire"}} <input type="checkbox" name="system.indirect" {{checked system.indirect}}></label>
  </div>
  {{/if}}
  {{#if sec.shotgun}}
  <h3 class="sr2e-subhead" data-heading="Shotgun">{{sr2eT "SR2E.UI.shotgun"}}</h3>
  <div class="sr2e-row">
    {{#if sec.all}}<label>{{sr2eT "SR2E.UI.shotgun"}} <input type="checkbox" name="system.shotgun" {{checked system.shotgun}}></label>{{/if}}
    <label>{{sr2eT "SR2E.UI.choke"}} <input type="number" name="system.choke" value="{{system.choke}}" min="1"></label>
  </div>
  {{/if}}
  {{#if sec.launcher}}
  <h3 class="sr2e-subhead" data-heading="Missile">{{sr2eT "SR2E.UI.missile"}}</h3>
  <div class="sr2e-row">
    <label title="{{sr2eT "SR2E.UI.aMissileSIntelligenceRatingAdds"}}">{{sr2eT "SR2E.UI.missileIntelligence"}} <input type="number" name="system.guidance" value="{{system.guidance}}" min="0"></label>
  </div>
  {{/if}}
  {{#if sec.flame}}
  <h3 class="sr2e-subhead" data-heading="Flamethrower">{{sr2eT "SR2E.UI.flamethrower2"}}</h3>
  <div class="sr2e-row">
    <label title="{{sr2eT "SR2E.UI.aFlamethrowerHitsEveryoneInA"}}">{{sr2eT "SR2E.UI.area"}} <select name="system.areaKind">{{selectOptions areaChoices selected=system.areaKind valueAttr="key" labelAttr="label"}}</select></label>
  </div>
  {{/if}}
  {{#if sec.ranges}}
  <h3 class="sr2e-subhead" data-heading="Range">{{sr2eT "SR2E.UI.range"}}</h3>
  <div class="sr2e-row">
    <label>{{sr2eT "SR2E.UI.short"}} <input type="number" name="system.range.short" value="{{system.range.short}}" min="0"></label>
    <label>{{sr2eT "SR2E.UI.medium"}} <input type="number" name="system.range.medium" value="{{system.range.medium}}" min="0"></label>
    <label>{{sr2eT "SR2E.UI.long"}} <input type="number" name="system.range.long" value="{{system.range.long}}" min="0"></label>
    <label>{{sr2eT "SR2E.UI.extreme"}} <input type="number" name="system.range.extreme" value="{{system.range.extreme}}" min="0"></label>
  </div>
  {{/if}}
  {{#if sec.strengthRange}}
  <h3 class="sr2e-subhead" data-heading="Range from Strength">{{sr2eT "SR2E.UI.rangeFromStrength"}}</h3>
  <div class="sr2e-row">
    <label title="{{sr2eT "SR2E.UI.thrownWeaponsAndBowsRangeLimits"}}">{{sr2eT "SR2E.UI.rangeFromStrength"}} <input type="checkbox" name="system.strengthRange" {{checked system.strengthRange}}></label>
    <label>{{sr2eT "SR2E.UI.short2"}} <input type="number" name="system.strengthRangeMultipliers.short" value="{{system.strengthRangeMultipliers.short}}" min="0" step="0.5"></label>
    <label>{{sr2eT "SR2E.UI.medium2"}} <input type="number" name="system.strengthRangeMultipliers.medium" value="{{system.strengthRangeMultipliers.medium}}" min="0" step="0.5"></label>
    <label>{{sr2eT "SR2E.UI.long2"}} <input type="number" name="system.strengthRangeMultipliers.long" value="{{system.strengthRangeMultipliers.long}}" min="0" step="0.5"></label>
    <label>{{sr2eT "SR2E.UI.extreme2"}} <input type="number" name="system.strengthRangeMultipliers.extreme" value="{{system.strengthRangeMultipliers.extreme}}" min="0" step="0.5"></label>
  </div>
  {{/if}}
  <h3 class="sr2e-subhead" data-heading="Handling">{{sr2eT "SR2E.UI.handling"}}</h3>
  <div class="sr2e-row">
    {{#unless system.melee}}<label title="{{sr2eT "SR2E.UI.howItIsLoadedAClip"}}">{{sr2eT "SR2E.UI.feed"}} <select name="system.feed">{{selectOptions feedChoices selected=system.feed valueAttr="key" labelAttr="label"}}</select></label>{{/unless}}
    <label title="{{sr2eT "SR2E.UI.whichArmorStopsIt"}}">{{sr2eT "SR2E.UI.armor"}} <select name="system.armorKind">{{selectOptions armorKindChoices selected=system.armorKind valueAttr="key" labelAttr="label"}}</select></label>
    <label title="{{sr2eT "SR2E.UI.drawnAndReadyToUseDrawing"}}">{{sr2eT "SR2E.UI.drawn"}} <input type="checkbox" name="system.ready" {{checked system.ready}}></label>
    <label title="{{sr2eT "SR2E.UI.quickDrawHolsterDrawingIsFree"}}">{{sr2eT "SR2E.UI.quickDrawHolster"}} <input type="checkbox" name="system.quickDraw" {{checked system.quickDraw}}></label>
  </div>
  <h3 class="sr2e-subhead" data-heading="Toxin and cybergun">{{sr2eT "SR2E.UI.toxinAndCybergun"}}</h3>
  <div class="sr2e-row">
    <label title="{{sr2eT "SR2E.UI.aToxinItDeliversADart"}}">{{sr2eT "SR2E.UI.toxin"}} <select name="system.toxinId">{{selectOptions toxinChoices selected=system.toxinId valueAttr="key" labelAttr="label"}}</select></label>
    <label title="{{sr2eT "SR2E.UI.onlyWhenTheHitDoesDamage"}}">{{sr2eT "SR2E.UI.onlyIfItWounds"}} <input type="checkbox" name="system.toxinNeedsWound" {{checked system.toxinNeedsWound}}></label>
    <label title="{{sr2eT "SR2E.UI.aCybergunItOnlyWorksWhile"}}">{{sr2eT "SR2E.UI.builtInto"}} <select name="system.implantId">{{selectOptions implantChoices selected=system.implantId valueAttr="key" labelAttr="label"}}</select></label>
  </div>
  <h3 class="sr2e-subhead" data-heading="Weight and mount">{{sr2eT "SR2E.UI.weightAndMount"}}</h3>
  <div class="sr2e-row">
    <label>{{sr2eT "SR2E.UI.weightKg"}} <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.1"></label>
    <label>{{sr2eT "SR2E.UI.concealability"}} <input type="number" name="system.concealability" value="{{system.concealability}}" min="0"></label>
    {{#if sec.vehicle}}<label title="{{sr2eT "SR2E.UI.onAVehicleFixedDriverOr"}}">{{sr2eT "SR2E.UI.mount"}}
      <select name="system.mount">{{selectOptions mountChoices selected=system.mount valueAttr="key" labelAttr="label"}}</select>
    </label>
    {{#unless (eq system.mount "none")}}<label title="{{sr2eT "SR2E.UI.theMountPointItTakesOn"}}">{{sr2eT "SR2E.UI.point"}}
      <select name="system.mountPoint">{{selectOptions mountPointChoices selected=system.mountPoint valueAttr="key" labelAttr="label"}}</select>
    </label>{{/unless}}
    {{#if (eq system.mount "fixed")}}<label title="{{sr2eT "SR2E.UI.theSideAFixedMountFaces"}}">{{sr2eT "SR2E.UI.arc"}}
      <select name="system.arc">{{selectOptions arcChoices selected=system.arc valueAttr="key" labelAttr="label"}}</select>
    </label>{{/if}}{{/if}}
    <label title="{{sr2eT "SR2E.UI.antiVehicleFullPowerAndDamage"}}">{{sr2eT "SR2E.UI.antiVehicle"}} <input type="checkbox" name="system.antiVehicle" {{checked system.antiVehicle}}></label>
    <label title="{{sr2eT "SR2E.UI.bulkInCargoFactorUnitsA"}}">{{sr2eT "SR2E.UI.cf3"}} <input type="number" name="system.cf" value="{{system.cf}}" min="0" step="0.5"></label>
  </div>
  {{#if sec.vehicle}}{{#if (eq system.mount "turret")}}
  <h3 class="sr2e-subhead" data-heading="Turret">{{sr2eT "SR2E.UI.turret"}}</h3>
  <div class="sr2e-row">
    <label title="{{sr2eT "SR2E.UI.whereTheTurretPointsNowIn"}}">{{sr2eT "SR2E.UI.turretFacing"}} <input type="number" name="system.turret.facing" value="{{system.turret.facing}}" step="1"></label>
    <label title="{{sr2eT "SR2E.UI.howFarItTurnsPerShot" traverse=turretDefaults.traverse}}">{{sr2eT "SR2E.UI.traverse"}} <input type="number" name="system.turret.traverse" value="{{system.turret.traverse}}" min="0"></label>
    <label title="{{sr2eT "SR2E.UI.theArcItCanCoverCentred" limit=turretDefaults.limit}}">{{sr2eT "SR2E.UI.limit"}} <input type="number" name="system.turret.limit" value="{{system.turret.limit}}" min="0" max="360"></label>
  </div>
  {{/if}}{{/if}}
  {{/if}}

  {{#if (eq type "armor")}}
  <div class="sr2e-row">
    <label>{{sr2eT "SR2E.UI.ballistic"}} <input type="number" name="system.ballistic" value="{{system.ballistic}}" min="0"></label>
    <label>{{sr2eT "SR2E.UI.impact"}} <input type="number" name="system.impact" value="{{system.impact}}" min="0"></label>
    <label>{{sr2eT "SR2E.UI.worn"}} <input type="checkbox" name="system.worn" {{checked system.worn}}></label>
    <label title="{{sr2eT "SR2E.UI.helmetsFormFittingArmorShieldsAdd"}}">{{sr2eT "SR2E.UI.addsToOtherArmor"}} <input type="checkbox" name="system.adds" {{checked system.adds}}></label>
    <label title="{{sr2eT "SR2E.UI.pointsLostToDamageArmorDegrading"}}">{{sr2eT "SR2E.UI.damaged2"}} <input type="number" name="system.degraded" value="{{system.degraded}}" min="0"></label>
    <label>{{sr2eT "SR2E.UI.weightKg"}} <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.1"></label>
    <label>{{sr2eT "SR2E.UI.concealability"}} <input type="number" name="system.concealability" value="{{system.concealability}}" min="0"></label>
    <label>{{sr2eT "SR2E.UI.shieldParry"}} <input type="number" name="system.parry" value="{{system.parry}}" min="0"></label>
    <label title="{{sr2eT "SR2E.UI.bulkInCargoFactorUnitsA"}}">{{sr2eT "SR2E.UI.cf3"}} <input type="number" name="system.cf" value="{{system.cf}}" min="0" step="0.5"></label>
  </div>
  {{/if}}

  {{#if (eq type "cyberware")}}
