      {{#if underway.length}}
      <h2 data-heading="Under way">{{sr2eT "SR2E.UI.underWay"}}</h2>
      <ul class="sr2e-underway">
        {{#each underway}}<li class="{{#if due}}sr2e-due{{/if}}"><span><strong>{{label}}</strong> · {{left}}{{#if paid}} <span class="hint">{{sr2eT "SR2E.UI.paid" paid=paid}}</span>{{/if}}</span>
          <span class="sr2e-underway-acts">{{#if training}}<button type="button" data-action="trainWith" data-training-id="{{id}}" title="{{sr2eT "SR2E.UI.anInstructorSInstructionTestDivides"}}">{{sr2eT "SR2E.UI.instructor"}}</button>{{/if}}
          {{#if @root.isGM}}<a data-action="projectTime" data-project-id="{{id}}" data-training="{{#if training}}1{{/if}}" data-sr2e-gm title="{{sr2eT "SR2E.UI.changeTheTimeLeftGm"}}"><i class="fa-solid fa-hourglass-half"></i></a>
          <a data-action="projectFinish" data-project-id="{{id}}" data-training="{{#if training}}1{{/if}}" data-sr2e-gm title="{{sr2eT "SR2E.UI.finishItNowGm"}}"><i class="fa-solid fa-forward-fast"></i></a>{{/if}}
          <a data-action="projectCancel" data-project-id="{{id}}" data-training="{{#if training}}1{{/if}}" title="{{sr2eT "SR2E.UI.giveItUpWhatWasPaid"}}"><i class="fa-solid fa-xmark"></i></a></span></li>{{/each}}
      </ul>
      <p class="hint">{{sr2eT "SR2E.UI.thingsThatTakeTimeArriveWhen"}}</p>
      {{/if}}
      <h2 data-heading="Contacts">{{sr2eT "SR2E.UI.contacts"}} <a data-action="addContact" title="{{sr2eT "SR2E.UI.addAContact"}}"><i class="fa-solid fa-plus"></i></a></h2>
      <ul>
        {{#each upkeep.contacts}}
        <li>
          <a data-action="editContact" data-contact-id="{{id}}" title="{{sr2eT "SR2E.UI.edit"}}">{{name}}</a>
          <span>{{sr2eT "SR2E.UI.loyalty" levelLabel=levelLabel loyalty=loyalty}}{{#if role}} · {{role}}{{/if}}{{#if skills}} {{sr2eT "SR2E.UI.knows" skills=skills}}{{/if}}{{#if dice}} {{sr2eT "SR2E.UI.digsWithDice" dice=dice}}{{/if}}{{#if fee}} {{sr2eT "SR2E.UI.fee" fee=fee}}{{/if}}{{#if fixer}} · <strong>{{sr2eT "SR2E.UI.fixer"}}</strong>{{/if}}{{#if favourLabel}} · <strong>{{favourLabel}}</strong>{{/if}}{{#if notes}} · <em>{{notes}}</em>{{/if}}</span>
          <a data-action="favour" data-contact-id="{{id}}" data-delta="1" title="{{sr2eT "SR2E.UI.theyOweYouOneMoreFavour"}}"><i class="fa-solid fa-handshake"></i>+</a>
          <a data-action="favour" data-contact-id="{{id}}" data-delta="-1" title="{{sr2eT "SR2E.UI.theyOweYouOneFewerOr"}}"><i class="fa-solid fa-handshake"></i>−</a>
          <button type="button" data-action="legwork" data-contact-id="{{id}}" title="{{sr2eT "SR2E.UI.askAroundThroughThisContact"}}">{{sr2eT "SR2E.UI.legwork"}}</button>
          <a data-action="deleteContact" data-contact-id="{{id}}" title="{{sr2eT "SR2E.UI.delete"}}"><i class="fa-solid fa-trash"></i></a>
        </li>
        {{else}}<li class="sr2e-empty"><em>{{sr2eT "SR2E.UI.noContactsYetPress"}} <i class="fa-solid fa-plus"></i> {{sr2eT "SR2E.UI.toAddOne"}}</em></li>
        {{/each}}
      </ul>
      <h2 data-heading="Ledger">{{sr2eT "SR2E.UI.ledger"}}</h2>
      <ul class="sr2e-ledger">
        {{#each upkeep.ledger}}<li><span class="{{#if negative}}sr2e-warn{{/if}}">{{amountLabel}}</span> {{reason}} <em>({{when}})</em></li>{{else}}<li><em>{{sr2eT "SR2E.UI.nothingRecordedYet"}}</em></li>{{/each}}
      </ul>
    </section>
  </section>
  {{/if}}
  {{#if creation}}
  <section class="tab sr2e-tab{{#if (eq activeTab "creation")}} active{{/if}}" data-group="primary" data-tab="creation">
    <section class="sr2e-creation">
      {{#if creation.pending.length}}
      <h2 data-heading="Waiting for the GM">{{sr2eT "SR2E.UI.waitingForTheGm"}}</h2>
      <ul class="sr2e-list">
        {{#each creation.pending}}<li><span><strong>{{label}}</strong> · {{cost}} · <span class="hint">{{who}}</span></span> <a data-action="cancelRequest" data-id="{{id}}" title="{{sr2eT "SR2E.UI.cancelTheRequest"}}"><i class="fa-solid fa-xmark"></i></a></li>{{/each}}
      </ul>
      {{#if creation.isGM}}<p class="hint sr2e-gm-only">{{sr2eT "SR2E.UI.approveOrDeclineThemInThe"}}</p>{{/if}}
      {{/if}}
      {{#if creation.record}}
      <h2 data-heading="Creation record">{{sr2eT "SR2E.UI.creationRecord"}}</h2>
      <p class="hint">{{sr2eT "SR2E.UI.finishedByIn" when=creation.record.when by=creation.record.by how=creation.record.how}}{{#if creation.record.failed}} <strong class="sr2e-warn">{{sr2eT "SR2E.UI.buildCheckSWereNotMet" failed=creation.record.failed}}</strong>{{/if}}</p>
      <div class="sr2e-row">
        {{#if creation.canEdit}}<button type="button" data-action="spendKarma"><i class="fa-solid fa-star"></i> {{sr2eT "SR2E.UI.spendKarma"}}</button>{{/if}}
        {{#if creation.isGM}}<button type="button" class="sr2e-gm-only" data-action="advNote" title="{{sr2eT "SR2E.UI.writeALineIntoTheAdvancement"}}"><i class="fa-solid fa-pen"></i> {{sr2eT "SR2E.UI.logNote"}}</button>
        <button type="button" data-action="reopenCreation" title="{{sr2eT "SR2E.UI.throwTheRecordAwayAndOpen"}}"><i class="fa-solid fa-rotate-left"></i> {{sr2eT "SR2E.UI.reopenCreation"}}</button>{{/if}}
      </div>
      <div class="sr2e-creation-grid">
        <div><h3 data-help="creation-record" data-heading="Build">{{sr2eT "SR2E.UI.build"}}</h3>
          <ul class="sr2e-list">
            <li>{{creation.record.metatype}} · {{creation.record.magic}}</li>
            {{#each creation.record.priorities}}<li>{{label}} <strong>{{letter}}</strong>{{#if what}} <span class="hint">{{what}}</span>{{/if}}</li>{{/each}}
            <li>{{sr2eT "SR2E.UI.essence2" essence=creation.record.essence}}</li>
            <li>{{sr2eT "SR2E.UI.goodKarmaKarmaPool" nuyen=creation.record.nuyen good=creation.record.karma.good pool=creation.record.karma.pool}}</li>
            <li>{{sr2eT "SR2E.UI.lifestyle3" lifestyle=creation.record.lifestyle}}</li>
          </ul>
        </div>
        <div><h3 data-help="creation-record" data-heading="Attributes">{{sr2eT "SR2E.UI.attributes"}}</h3>
          <ul class="sr2e-list">{{#each creation.record.attributes}}<li>{{label}} <strong>{{natural}}</strong>{{#unless (eq base natural)}} <span class="hint">{{sr2eT "SR2E.UI.base3" base=base}}</span>{{/unless}}</li>{{/each}}</ul>
        </div>
      </div>
      <h3 data-help="creation-record" data-heading="Skills">{{sr2eT "SR2E.UI.skills"}}</h3>
      <ul class="sr2e-list sr2e-inline-list">{{#each creation.record.skills}}<li>{{name}} <strong>{{rating}}</strong>{{#if extra}} ({{extra}}){{/if}}</li>{{else}}<li><em>{{sr2eT "SR2E.UI.none"}}</em></li>{{/each}}</ul>
      {{#if creation.record.spells.length}}<h3 data-help="creation-record" data-heading="Spells">{{sr2eT "SR2E.UI.spells"}}</h3><ul class="sr2e-list sr2e-inline-list">{{#each creation.record.spells}}<li>{{name}} F{{force}}</li>{{/each}}</ul>{{/if}}
      {{#if creation.record.adeptPowers.length}}<h3 data-help="creation-record" data-heading="Adept powers">{{sr2eT "SR2E.UI.adeptPowers"}}</h3><ul class="sr2e-list sr2e-inline-list">{{#each creation.record.adeptPowers}}<li>{{name}} {{level}}</li>{{/each}}</ul>{{/if}}
      {{#if creation.record.cyberware.length}}<h3 data-help="creation-record" data-heading="Cyberware and bioware">{{sr2eT "SR2E.UI.cyberwareAndBioware"}}</h3><ul class="sr2e-list sr2e-inline-list">{{#each creation.record.cyberware}}<li>{{name}}{{#if rating}} {{rating}}{{/if}} <span class="hint">{{grade}}{{#unless bioware}}{{sr2eT "SR2E.UI.essence3" essence=essence}}{{/unless}}</span></li>{{/each}}</ul>{{/if}}
      {{#if creation.record.gear.length}}<h3 data-help="creation-record" data-heading="Gear">{{sr2eT "SR2E.UI.gear"}}</h3><ul class="sr2e-list sr2e-inline-list">{{#each creation.record.gear}}<li>{{name}}{{#if rating}} ({{rating}}){{/if}}{{#if (gt quantity 1)}} ×{{quantity}}{{/if}}</li>{{/each}}</ul>{{/if}}
      {{#if creation.record.contacts.length}}<h3 data-help="creation-record" data-heading="Contacts">{{sr2eT "SR2E.UI.contacts"}}</h3><ul class="sr2e-list sr2e-inline-list">{{#each creation.record.contacts}}<li>{{name}} <span class="hint">{{sr2eT "SR2E.UI.level4" level=level}}{{#if role}}, {{role}}{{/if}}</span></li>{{/each}}</ul>{{/if}}
      {{#if creation.record.qualities.length}}<h3 data-help="creation-record" data-heading="Edges and flaws">{{sr2eT "SR2E.UI.edgesAndFlaws"}}</h3><ul class="sr2e-list sr2e-inline-list">{{#each creation.record.qualities}}<li>{{name}} <span class="hint">{{kind}} {{points}}</span></li>{{/each}}</ul>{{/if}}
      {{#if creation.record.checks.length}}
      <details class="sr2e-creation-checks"><summary data-heading="Build checks at the finish">{{sr2eT "SR2E.UI.buildChecksAtTheFinish"}}</summary>
        <table class="sr2e-build"><tbody>{{#each creation.record.checks}}<tr class="{{#unless ok}}sr2e-warning{{/unless}}"><td>{{#if ok}}✓{{else}}✗{{/if}} {{label}}</td><td>{{used}}</td><td>{{allowed}}</td><td>{{note}}</td></tr>{{/each}}</tbody></table>
      </details>
      {{/if}}

      <h2 data-heading="Advancement log">{{sr2eT "SR2E.UI.advancementLog"}}</h2>
      {{#if creation.totals.lines}}<p class="hint">{{sr2eT "SR2E.UI.lineSKarmaInSpent" lines=creation.totals.lines karmaIn=creation.totals.karmaIn karmaSpent=creation.totals.karmaSpent}}{{#if creation.totals.nuyenSpent}}{{sr2eT "SR2E.UI.onPurchases" nuyenSpent=creation.totals.nuyenSpent}}{{/if}}.</p>{{/if}}
      <ul class="sr2e-list sr2e-advlog">
        {{#each creation.log}}<li class="sr2e-adv-{{cls}}"><span class="sr2e-adv-when" title="{{at}}">{{when}}</span> <span class="sr2e-adv-what">{{what}}</span>{{#if cost}} <strong class="sr2e-adv-cost">{{cost}}</strong>{{/if}} <span class="hint">{{#if by}}{{by}}{{/if}}{{#if approvedBy}} {{sr2eT "SR2E.UI.approvedBy" approvedBy=approvedBy}}{{/if}}</span>{{#if ../creation.isGM}} <a data-action="advDelete" data-id="{{id}}" title="{{sr2eT "SR2E.UI.deleteTheLineOnlyTheLog"}}"><i class="fa-solid fa-trash"></i></a>{{/if}}</li>
        {{else}}<li><em>{{sr2eT "SR2E.UI.nothingGainedSinceCreationYet"}}</em></li>{{/each}}
      </ul>
      {{else}}
      <h2 data-heading="Character creation">{{sr2eT "SR2E.UI.characterCreation"}}</h2>
      {{#if creation.inCreation}}<p>{{sr2eT "SR2E.UI.isBeingBuiltInTheCreation" name=actor.name}}</p>{{else}}<p>{{sr2eT "SR2E.UI.hasNoCreationRecordYet" name=actor.name}}</p>{{/if}}
      <div class="sr2e-row">
        {{#if creation.canEdit}}<button type="button" data-action="openWizard"><i class="fa-solid fa-wand-magic-sparkles"></i> {{#if creation.inCreation}}{{sr2eT "SR2E.UI.continueCreation"}}{{else}}{{sr2eT "SR2E.UI.createCharacter"}}{{/if}}</button>
        <button type="button" data-action="recordAsIs" title="{{sr2eT "SR2E.UI.forACharacterMadeBeforeThe"}}"><i class="fa-solid fa-lock"></i> {{sr2eT "SR2E.UI.recordAsItStands"}}</button>{{/if}}
      </div>
      <p class="hint">{{sr2eT "SR2E.UI.theWizardWalksThroughThePriorities"}}</p>
      {{/if}}
    </section>
  </section>
  {{/if}}
  <section class="tab sr2e-tab{{#if (eq activeTab "bio")}} active{{/if}}" data-group="primary" data-tab="bio">
    <section class="sr2e-bio">
      {{#if creation}}{{#unless creation.record}}<p><button type="button" data-action="openWizard" title="{{sr2eT "SR2E.UI.buildTheCharacterStepByStep"}}"><i class="fa-solid fa-wand-magic-sparkles"></i> {{#if creation.inCreation}}{{sr2eT "SR2E.UI.continueCreation"}}{{else}}{{sr2eT "SR2E.UI.createCharacter"}}{{/if}}</button>
        <button type="button" data-action="buildCheck" title="{{sr2eT "SR2E.UI.theOldQuickBuilderCheckAgainst"}}"><i class="fa-solid fa-list-check"></i> {{sr2eT "SR2E.UI.quickBuild"}}</button>
        <button type="button" data-action="importCharacter" title="{{sr2eT "SR2E.UI.fillTheSheetFromAPasted"}}"><i class="fa-solid fa-file-import"></i> {{sr2eT "SR2E.UI.importAStatBlock"}}</button></p>{{/unless}}{{/if}}
      {{#if street.qualitiesOn}}
      <h2 data-heading="Edges and flaws">{{sr2eT "SR2E.UI.edgesAndFlaws"}} <a data-action="addQuality" title="{{sr2eT "SR2E.UI.addAnEdgeOrFlawBy"}}"><i class="fa-solid fa-plus"></i></a>{{#if (eq actor.type "character")}} <a data-action="gainEdge" title="{{sr2eT "SR2E.UI.gainAnEdgeInPlayGood" edgeRate=street.edgeRate}}"><i class="fa-solid fa-star"></i></a>{{/if}}</h2>
      <ul>
        {{#each street.qualities}}
        <li><a data-action="editQuality" data-quality-id="{{id}}">{{name}}</a> <span>{{kind}} {{points}}{{#if tnLabel}} · {{tnLabel}}{{/if}}{{#if notes}} · <em>{{notes}}</em>{{/if}}</span>
          {{#if buyOff}}<a data-action="buyOffFlaw" data-quality-id="{{id}}" title="{{sr2eT "SR2E.UI.buyItOffForGoodKarma" buyOff=buyOff}}"><i class="fa-solid fa-coins"></i> {{buyOff}}</a>{{/if}}
          <a data-action="deleteQuality" data-quality-id="{{id}}" title="{{sr2eT "SR2E.UI.delete"}}"><i class="fa-solid fa-trash"></i></a></li>
        {{else}}<li class="sr2e-empty"><em>{{sr2eT "SR2E.UI.noEdgesOrFlawsPress"}} <i class="fa-solid fa-plus"></i> {{sr2eT "SR2E.UI.toAddOne"}}</em></li>
        {{/each}}
      </ul>
      <p class="hint">{{sr2eT "SR2E.UI.edgesFlawsTheBuildCheckCounts" edges=street.qualityTotals.edges flaws=street.qualityTotals.flaws}}</p>
      {{/if}}
      {{#if street.reputationOn}}
      <h2 data-heading="Reputation">{{sr2eT "SR2E.UI.reputation"}}</h2>
      <div class="sr2e-row">
        {{#if street.autoCred}}<span title="{{sr2eT "SR2E.UI.careerKarmaTheHouseRuleRate"}}">{{sr2eT "SR2E.UI.streetCred"}} <strong>{{street.streetCred}}</strong></span>{{else}}<label>{{sr2eT "SR2E.UI.streetCred"}} <input type="number" name="system.reputation.streetCred" value="{{system.reputation.streetCred}}" min="0"></label>{{/if}}
        <label>{{sr2eT "SR2E.UI.notoriety"}} <input type="number" name="system.reputation.notoriety" value="{{system.reputation.notoriety}}" min="0"></label>
        <label>{{sr2eT "SR2E.UI.publicAwareness"}} <input type="number" name="system.reputation.publicAwareness" value="{{system.reputation.publicAwareness}}" min="0"></label>
        {{#if street.notorietyOff}}<span title="{{sr2eT "SR2E.UI.streetCredAfterNotorietyHouseRule"}}">{{sr2eT "SR2E.UI.reputation"}} <strong>{{system.derived.streetCred}}</strong></span>{{/if}}
        {{#if isGM}}<button type="button" class="sr2e-gm-only" data-action="recognition" title="{{sr2eT "SR2E.UI.doesAnyoneRecogniseThemEachTargeted" recognitionTn=street.recognitionTn}}">{{sr2eT "SR2E.UI.recognised"}}</button>{{/if}}
      </div>
      {{/if}}
      {{#if art}}
      <h2 data-heading="Picture and token">{{sr2eT "SR2E.UI.pictureAndToken"}}</h2>
      <div class="sr2e-row sr2e-art">
        <img class="sr2e-art-preview" src="{{art.src}}" width="64" height="64" alt="" title="{{sr2eT "SR2E.UI.theDefaultArtThis"}} {{#if (eq actor.type "npc")}}{{sr2eT "SR2E.UI.npc"}}{{else}}{{sr2eT "SR2E.UI.character"}}{{/if}} {{sr2eT "SR2E.UI.gets"}}">
        <label>{{sr2eT "SR2E.UI.figure"}} <select name="system.art.figure">{{#each art.figures}}<option value="{{id}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label>{{sr2eT "SR2E.UI.archetype"}} <select name="system.art.archetype">{{#each art.archetypes}}<option value="{{id}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        {{#if editable}}<button type="button" data-action="useDefaultArt" title="{{sr2eT "SR2E.UI.useThisDefaultArtForThe"}}"><i class="fa-solid fa-image-portrait"></i> {{sr2eT "SR2E.UI.useTheDefaultArt"}}</button>{{/if}}
      </div>
      <p class="hint">{{#if art.isDefault}}{{sr2eT "SR2E.UI.thePictureAndTokenFollowThese"}}{{else}}{{#if art.standIn}}{{sr2eT "SR2E.UI.thisActorStillHasFoundryS"}}{{else}}{{sr2eT "SR2E.UI.thisActorHasAPictureOf"}}{{/if}}{{/if}} {{sr2eT "SR2E.UI.theBadgeShowsTheArchetypeAutomatic"}}</p>
      {{/if}}
      <h2 data-heading="Biography">{{sr2eT "SR2E.UI.biography"}}</h2>
      {{#if editable}}<prose-mirror class="sr2e-rich" name="system.biography" toggled value="{{richSource.biography}}">{{{enriched.biography}}}</prose-mirror>{{else}}<div class="sr2e-rich">{{{enriched.biography}}}</div>{{/if}}
      <h2 data-heading="Notes">{{sr2eT "SR2E.UI.notes"}}</h2>
      {{#if editable}}<prose-mirror class="sr2e-rich" name="system.notes" toggled value="{{richSource.notes}}">{{{enriched.notes}}}</prose-mirror>{{else}}<div class="sr2e-rich">{{{enriched.notes}}}</div>{{/if}}
    </section>
  </section>
</div>
