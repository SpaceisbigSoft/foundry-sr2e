<div class="sr2e-sheet sr2e-layout-{{layout}}">
  <header class="sr2e-header">
    <img src="{{actor.img}}" alt="" width="72" height="72" data-edit="img">
    <div class="sr2e-header-main">
      <input type="text" name="name" value="{{actor.name}}" placeholder="{{sr2eT "SR2E.UI.name"}}">
      <div class="sr2e-header-meta">
      <label class="sr2e-inline">{{sr2eT "SR2E.UI.metatype"}}
        <select name="system.metatype">{{selectOptions metatypeChoices selected=system.metatype valueAttr="key" labelAttr="label"}}</select>
      </label>
      <label class="sr2e-inline" title="{{sr2eT "SR2E.UI.untickIfTheBaseRatingsAlready"}}">{{sr2eT "SR2E.UI.addRacialModifiers"}} <input type="checkbox" name="system.racialModifiers" {{checked system.racialModifiers}}></label>
      </div>
    </div>
  </header>
  {{> "systems/sr2e/templates/sheet-summary.hbs"}}
  <div class="sr2e-stuck">
    {{> "systems/sr2e/templates/status-strip.hbs"}}
    <nav class="sheet-tabs tabs sr2e-tabs" data-group="primary">
      {{#each sheetTabs}}<a class="item{{#if active}} active{{/if}}" data-action="tab" data-group="primary" data-tab="{{id}}"><i class="{{icon}}" aria-hidden="true"></i> {{label}}</a>{{/each}}
    </nav>
  </div>
  {{#if (eq layout "combat")}}{{> "systems/sr2e/templates/combat-column.hbs"}}{{/if}}
  <section class="tab sr2e-tab{{#if (eq activeTab "main")}} active{{/if}}" data-group="primary" data-tab="main">
    <section class="sr2e-attributes">
      <h2 data-heading="Attributes">{{sr2eT "SR2E.UI.attributes"}}</h2>
      <table>
        <thead><tr><th></th><th>{{sr2eT "SR2E.UI.base"}}</th><th>{{sr2eT "SR2E.UI.racial"}}</th><th>{{sr2eT "SR2E.UI.mod"}}</th><th>{{sr2eT "SR2E.UI.gear"}}</th><th>{{sr2eT "SR2E.UI.total"}}</th></tr></thead>
        <tbody>
          {{#each attributes}}
          <tr>
            <td><a data-action="rollAttribute" data-attribute="{{key}}" title="{{sr2eT "SR2E.UI.roll"}}">{{label}}</a>{{#if improve.ok}} <a class="sr2e-improve" data-action="improve" data-attribute="{{key}}" title="{{sr2eT "SR2E.UI.raiseToKarma" to=improve.to cost=improve.cost}}"><i class="fa-solid fa-circle-plus"></i></a>{{/if}}</td>
            <td><input type="number" name="system.attributes.{{key}}.base" value="{{base}}" min="0" aria-label="{{sr2eT "SR2E.UI.base2" label=label}}"></td>
            <td>{{#if racial}}{{racial}}{{else}}&ndash;{{/if}}</td>
            <td><input type="number" class="sr2e-play-ok" name="system.attributes.{{key}}.mod" value="{{mod}}" title="{{sr2eT "SR2E.UI.temporaryModifierStaysEditableInPlay"}}" aria-label="{{sr2eT "SR2E.UI.temporaryModifier" label=label}}"></td>
            <td>{{#if gear}}+{{gear}}{{else}}&ndash;{{/if}}</td>
            <td>{{total}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{#if system.derived.attributeWarnings.length}}<ul class="sr2e-warnings">{{#each system.derived.attributeWarnings}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
      <div class="sr2e-row">
        <label>{{sr2eT "SR2E.UI.baseEssence"}} <input type="number" name="system.essence" value="{{system.essence}}" step="0.01" min="0"></label>
        {{#if system.essenceShift}}<label title="{{sr2eT "SR2E.UI.essenceDrainedNegativeOrGainedPositive"}}">{{sr2eT "SR2E.UI.drainedGained"}} <input type="number" name="system.essenceShift" value="{{system.essenceShift}}" step="0.1"></label>{{/if}}
        {{#if essenceHoles}}<label title="{{sr2eT "SR2E.UI.essenceLostToCyberwareThatCame"}}">{{sr2eT "SR2E.UI.essenceHole"}} <input type="number" name="system.essenceHole" value="{{system.essenceHole}}" step="0.01" min="0"></label>{{/if}}
        <label>{{sr2eT "SR2E.UI.magicNatural"}} <input type="number" name="system.magic" value="{{system.magic}}" min="0"></label>
        <label>{{sr2eT "SR2E.UI.lowLight"}} <input type="checkbox" name="system.vision.lowLight" {{checked system.vision.lowLight}}></label>
        <label>{{sr2eT "SR2E.UI.thermographic"}} <input type="checkbox" name="system.vision.thermographic" {{checked system.vision.thermographic}}></label>
        <label>{{sr2eT "SR2E.UI.reactionBonus"}} <input type="number" name="system.reactionBonus" value="{{system.reactionBonus}}"></label>
        <label>{{sr2eT "SR2E.UI.extraInitiativeDice"}} <input type="number" name="system.initiativeDiceBonus" value="{{system.initiativeDiceBonus}}" min="0"></label>
      </div>
    </section>
    <section class="sr2e-derived">
      <h2 data-heading="Derived">{{sr2eT "SR2E.UI.derived"}}</h2>
      <div class="sr2e-row">
        <span{{#if essenceWare}} title="{{essenceWare}}"{{/if}}>{{sr2eT "SR2E.UI.essence"}} <strong>{{system.derived.essence}}</strong>{{#if system.derived.essenceLoss}} (−{{system.derived.essenceLoss}}){{/if}}{{#if system.derived.essenceHole}} <span title="{{sr2eT "SR2E.UI.essenceLostToCyberwareThatCame2"}}">{{sr2eT "SR2E.UI.hole" essenceHole=system.derived.essenceHole}}</span>{{/if}}</span>
        {{#if system.derived.bodyIndex.used}}<span class="{{#if system.derived.bodyIndex.over}}sr2e-warning{{/if}}">{{sr2eT "SR2E.UI.bodyIndex"}} <strong>{{system.derived.bodyIndex.used}} / {{system.derived.bodyIndex.max}}</strong>{{#if system.derived.bodyIndex.magicLoss}} {{sr2eT "SR2E.UI.magic" magicLoss=system.derived.bodyIndex.magicLoss}}{{/if}}</span>{{/if}}
        <span>{{sr2eT "SR2E.UI.magic2"}} <strong>{{system.derived.magic}}</strong></span>
        <span>{{sr2eT "SR2E.UI.reaction"}} <strong>{{system.derived.reaction}}</strong></span>
        <span>{{sr2eT "SR2E.UI.initiative"}} <strong>{{system.derived.reaction}} + {{system.derived.initiativeDice}}d6</strong></span>
        <span>{{sr2eT "SR2E.UI.combatPool"}} <strong>{{system.derived.combatPoolLeft}} / {{system.derived.combatPool}}</strong></span>
        <span>{{sr2eT "SR2E.UI.spellPool"}} <strong>{{system.derived.spellPoolLeft}} / {{system.derived.spellPool}}</strong></span>
        {{#if street.movement}}<span title="{{sr2eT "SR2E.UI.metresPerCombatTurn"}}">{{sr2eT "SR2E.UI.walk"}} <strong>{{street.movement.walk}} m</strong> {{sr2eT "SR2E.UI.run"}} <strong>{{street.movement.run}} m</strong></span>{{/if}}
      </div>
      <div class="sr2e-row">
        <label>{{sr2eT "SR2E.UI.combatPoolSpent"}} <input type="number" name="system.poolSpent.combat" value="{{system.poolSpent.combat}}" min="0"></label>
        <label>{{sr2eT "SR2E.UI.karmaPool"}} <input type="number" name="system.karma.pool" value="{{system.karma.pool}}" min="0"></label>
        <span>{{sr2eT "SR2E.UI.karmaPoolLeft"}} <strong>{{system.derived.karmaPoolLeft}} / {{system.karma.pool}}</strong>
          <a data-action="refreshKarma" title="{{sr2eT "SR2E.UI.refreshKarmaPool"}}"><i class="fa-solid fa-rotate"></i></a></span>
        <label>{{sr2eT "SR2E.UI.goodKarma"}} <input type="number" name="system.karma.good" value="{{system.karma.good}}" min="0"></label>
      </div>
      {{#if system.derived.magic}}
      <div class="sr2e-row sr2e-astral">
        <label>{{sr2eT "SR2E.UI.astral"}}
          <select name="system.astral">{{selectOptions astralModes selected=system.astral valueAttr="key" labelAttr="label"}}</select>
        </label>
        {{#if (eq system.derived.astralMode "projecting")}}<span>{{sr2eT "SR2E.UI.astralBodyQuicknessInit" body=system.derived.astral.body quickness=system.derived.astral.quickness}} <strong>{{system.derived.astral.initiativeBase}} + {{system.derived.astral.initiativeDice}}d6</strong></span>{{/if}}
        {{#if (eq system.derived.astralMode "perceiving")}}<span>{{sr2eT "SR2E.UI.dualNaturedPhysicalAttacksTn" astralPerceivingMod=astralPerceivingMod}}</span>{{/if}}
        {{#if isAstral}}<button type="button" data-action="astralAttack">{{sr2eT "SR2E.UI.astralAttack"}}</button>{{/if}}
        {{#if canManifest}}<button type="button" data-action="manifest" title="{{sr2eT "SR2E.UI.beSeenAndHeardInThe"}}">{{#if manifesting}}{{sr2eT "SR2E.UI.stopManifesting"}}{{else}}{{sr2eT "SR2E.UI.manifest"}}{{/if}}</button>{{/if}}
        {{#if manifesting}}<span class="sr2e-status">{{sr2eT "SR2E.UI.manifesting"}}</span>{{/if}}
      </div>
      {{/if}}
      {{#if occult.possessedBy}}<p class="sr2e-warning">{{sr2eT "SR2E.UI.possessedBy"}} <strong>{{occult.possessedBy}}</strong>{{sr2eT "SR2E.UI.theBodyUsesTheirCharismaIntelligence"}} <button type="button" data-action="endPossession">{{sr2eT "SR2E.UI.free"}}</button></p>{{/if}}
      {{> "systems/sr2e/templates/power-effects.hbs"}}
    </section>
    <section class="sr2e-monitor">
      <h2 data-heading="Condition Monitor">{{sr2eT "SR2E.UI.conditionMonitor"}} <span class="sr2e-status">{{system.derived.status}}</span></h2>
      {{> "systems/sr2e/templates/monitor.hbs"}}
      <div class="sr2e-row">
        <label>{{sr2eT "SR2E.UI.physicalDamageBoxes"}} <input type="number" name="system.monitor.physical" value="{{system.monitor.physical}}" min="0"></label>
        <label>{{sr2eT "SR2E.UI.stunDamageBoxes"}} <input type="number" name="system.monitor.stun" value="{{system.monitor.stun}}" min="0"></label>
        <span>{{sr2eT "SR2E.UI.woundTnModifier"}} <strong>+{{system.derived.woundModifier}}</strong></span>
        <button type="button" data-action="resistDamage">{{sr2eT "SR2E.UI.resistDamage"}}</button>
        <button type="button" data-action="hazard" title="{{sr2eT "SR2E.UI.fallingFireDrowningColdFatigue"}}">{{sr2eT "SR2E.UI.hazard"}}</button>
        <button type="button" data-action="firstAid" title="{{sr2eT "SR2E.UI.firstAidOnThisCharacterOr"}}">{{sr2eT "SR2E.UI.firstAid"}}</button>
        <button type="button" data-action="naturalHeal" title="{{sr2eT "SR2E.UI.naturalHealingAfterRest"}}">{{sr2eT "SR2E.UI.restAndHeal"}}</button>
      </div>
      {{#if (eq system.derived.status "dying")}}<p class="sr2e-warning">{{sr2eT "SR2E.UI.dying"}}{{#if system.care.stabilised}} {{sr2eT "SR2E.UI.stabilised"}}{{else}}{{sr2eT "SR2E.UI.loses1MorePhysicalBoxUntil" bleedEvery=system.derived.bleedEvery}}{{/if}}.</p>{{/if}}
    </section>
    <section class="sr2e-items">
    {{#each skillGroups}}
    <h2 data-heading="{{heading}}">{{label}} <a class="sr2e-add" data-action="addSkill" data-kind="{{kind}}" title="{{sr2eT "SR2E.UI.addASkill"}}"><i class="fa-solid fa-plus"></i></a></h2>
    <ul>
      {{#each skills}}
      <li>
        <a data-action="rollSkill" data-item-id="{{id}}" title="{{sr2eT "SR2E.UI.roll"}}">{{name}}</a>
        <span><input type="number" class="sr2e-rowedit" data-item-id="{{id}}" data-field="system.rating" value="{{system.rating}}" min="0" title="{{sr2eT "SR2E.UI.rating"}}" aria-label="{{sr2eT "SR2E.UI.rating2" name=name}}">{{#if system.concentrationRating}} / {{system.concentration}} {{system.concentrationRating}}{{/if}}{{#if system.specializationRating}} / {{system.specialization}} {{system.specializationRating}}{{/if}} ({{system.attribute}}){{#if system.martial.enabled}} · <em>{{sr2eT "SR2E.UI.martialArt"}}</em>{{/if}} · <em>{{diceLabel}}</em></span>
        {{#if improve.ok}}<a class="sr2e-improve" data-action="improve" data-item-id="{{id}}" title="{{sr2eT "SR2E.UI.raiseToKarma" to=improve.to cost=improve.cost}}"><i class="fa-solid fa-circle-plus"></i></a>{{/if}}
        {{#if improveConc.ok}}<a class="sr2e-improve" data-action="improve" data-item-id="{{id}}" data-conc="1" title="{{sr2eT "SR2E.UI.raiseTheConcentrationToKarma" concentration=system.concentration to=improveConc.to cost=improveConc.cost}}"><i class="fa-solid fa-square-caret-up"></i></a>{{/if}}
        {{#if system.specialization}}{{#if improve}}<a class="sr2e-improve" data-action="improve" data-item-id="{{id}}" data-spec="1" title="{{sr2eT "SR2E.UI.raiseTheSpecialization" specialization=system.specialization}}"><i class="fa-solid fa-square-plus"></i></a>{{/if}}{{/if}}
        <a class="sr2e-pin{{#if (lookup @root.tools.pinSet id)}} on{{/if}}" data-action="pinItem" data-item-id="{{id}}" title="{{sr2eT "SR2E.UI.pinItToTheTopOf"}}"><i class="fa-solid fa-thumbtack"></i></a>
        <a data-action="editItem" data-item-id="{{id}}" data-sr2e-edit-pencil title="{{sr2eT "SR2E.UI.edit"}}"><i class="fa-solid fa-pen"></i></a>
        <a data-action="deleteItem" data-item-id="{{id}}" title="{{sr2eT "SR2E.UI.delete"}}"><i class="fa-solid fa-trash"></i></a>
      </li>
      {{else}}<li class="sr2e-empty"><em>{{sr2eT "SR2E.UI.noSkillsYetPress"}} <i class="fa-solid fa-plus"></i> {{sr2eT "SR2E.UI.toAddOne"}}</em></li>
      {{/each}}
      {{#if @first}}
      {{#each @root.softSkills}}
      <li class="sr2e-soft">
        <a data-action="rollSkill" data-item-id="{{id}}" data-skill-name="{{name}}" title="{{sr2eT "SR2E.UI.roll"}}">{{name}}</a>
        <span>{{system.rating}} ({{system.attribute}}) · <em>{{sr2eT "SR2E.UI.skillsoft" chipName=chipName}}</em></span>
      </li>
      {{/each}}
      {{/if}}
    </ul>
    {{/each}}
    </section>
  </section>
  {{#if current}}
  <section class="tab sr2e-tab{{#if (eq activeTab "current")}} active{{/if}}" data-group="primary" data-tab="current">
    <section class="sr2e-current">
      <p class="hint">{{sr2eT "SR2E.UI.whereStandsNowReadOnlyMain" name=actor.name}}{{#if current.hasRecord}} {{sr2eT "SR2E.UI.sinceComparesWithTheCreationRecord"}}{{/if}}</p>
      <h2 data-heading="Attributes">{{sr2eT "SR2E.UI.attributes"}}</h2>
      <table class="sr2e-current-table">
        <thead><tr><th></th><th>{{sr2eT "SR2E.UI.base"}}</th><th>{{sr2eT "SR2E.UI.natural"}}</th><th>{{sr2eT "SR2E.UI.now"}}</th>{{#if current.hasRecord}}<th>{{sr2eT "SR2E.UI.since"}}</th>{{/if}}</tr></thead>
        <tbody>
          {{#each current.attributes}}
          <tr><td>{{label}}</td><td>{{base}}</td><td>{{natural}}</td><td class="sr2e-current-total{{#if augmented}} sr2e-augmented{{/if}}" title="{{sources}}"><strong>{{total}}</strong></td>{{#if ../current.hasRecord}}<td class="sr2e-since">{{since}}</td>{{/if}}</tr>
          {{/each}}
          <tr><td>{{sr2eT "SR2E.UI.reaction"}}</td><td colspan="2"></td><td title="{{current.reaction.title}}"><strong>{{current.reaction.value}}</strong></td>{{#if current.hasRecord}}<td></td>{{/if}}</tr>
          <tr><td>{{sr2eT "SR2E.UI.essence"}}</td><td>{{current.essence.base}}</td><td></td><td title="{{sr2eT "SR2E.UI.baseWare" base=current.essence.base loss=current.essence.loss}}{{#if current.essence.hole}}{{sr2eT "SR2E.UI.hole2" hole=current.essence.hole}}{{/if}}"><strong>{{current.essence.value}}</strong></td>{{#if current.hasRecord}}<td class="sr2e-since">{{current.essence.since}}</td>{{/if}}</tr>
          {{#if current.magic}}<tr><td>{{sr2eT "SR2E.UI.magic2"}}</td><td>{{current.magic.base}}</td><td></td><td title="{{current.magic.tradition}}{{#if current.magic.grade}}{{sr2eT "SR2E.UI.initiateGrade" grade=current.magic.grade}}{{/if}}{{sr2eT "SR2E.UI.essenceLossAndGeasaLowerIt"}}"><strong>{{current.magic.value}}</strong></td>{{#if current.hasRecord}}<td class="sr2e-since">{{current.magic.since}}</td>{{/if}}</tr>{{/if}}
        </tbody>
      </table>
      <h2 data-heading="Initiative and pools">{{sr2eT "SR2E.UI.initiativeAndPools"}}</h2>
      <div class="sr2e-row sr2e-current-chips">
        <span class="sr2e-chip">{{sr2eT "SR2E.UI.initiative"}} <strong>{{current.initiative}}</strong></span>
        {{#if current.matrixInit}}<span class="sr2e-chip">{{sr2eT "SR2E.UI.matrix"}} <strong>{{current.matrixInit}}</strong></span>{{/if}}
        {{#if current.riggedInit}}<span class="sr2e-chip">{{sr2eT "SR2E.UI.rigged"}} <strong>{{current.riggedInit}}</strong></span>{{/if}}
        {{#each current.pools}}<span class="sr2e-chip">{{label}} <strong>{{left}}</strong>/{{total}}</span>{{/each}}
      </div>
      <h2 data-heading="Body">{{sr2eT "SR2E.UI.body"}}</h2>
      <div class="sr2e-row sr2e-current-chips">
        <span class="sr2e-chip">{{sr2eT "SR2E.UI.armor"}} <strong>{{current.armor.ballistic}}</strong>B / <strong>{{current.armor.impact}}</strong>I</span>
        <span class="sr2e-chip">{{sr2eT "SR2E.UI.physical"}} <strong>{{current.condition.physical}}</strong>/{{current.condition.boxes}}</span>
        <span class="sr2e-chip">{{sr2eT "SR2E.UI.stun"}} <strong>{{current.condition.stun}}</strong>/{{current.condition.boxes}}</span>
        {{#if current.condition.wound}}<span class="sr2e-chip">{{sr2eT "SR2E.UI.wounds"}} <strong>+{{current.condition.wound}}</strong> {{sr2eT "SR2E.UI.tn"}}</span>{{/if}}
        <span class="sr2e-chip sr2e-chip-soft">{{current.condition.status}}</span>
        <span class="sr2e-chip sr2e-chip-soft">{{current.metatype}}</span>
      </div>
      <h2 data-heading="Karma and money">{{sr2eT "SR2E.UI.karmaAndMoney"}} <a data-action="spendKarma" title="{{sr2eT "SR2E.UI.spendKarma"}}"><i class="fa-solid fa-star"></i></a></h2>
      <table class="sr2e-current-table">
        <tbody>
          <tr><td>{{sr2eT "SR2E.UI.goodKarmaUnspent"}}</td><td><strong>{{current.karma.good}}</strong></td>{{#if current.hasRecord}}<td class="sr2e-since">{{current.karma.goodSince}}</td>{{/if}}</tr>
          <tr><td>{{sr2eT "SR2E.UI.karmaEarnedInAll"}}</td><td><strong>{{current.karma.career}}</strong></td>{{#if current.hasRecord}}<td class="sr2e-since">{{#if current.karma.earnedSince}}+{{current.karma.earnedSince}}{{/if}}</td>{{/if}}</tr>
          <tr><td>{{sr2eT "SR2E.UI.karmaPool"}}</td><td><strong>{{current.karma.pool}}</strong></td>{{#if current.hasRecord}}<td></td>{{/if}}</tr>
          <tr><td>{{sr2eT "SR2E.UI.nuyen"}}</td><td><strong>¥{{current.nuyen.value}}</strong></td>{{#if current.hasRecord}}<td class="sr2e-since">{{current.nuyen.since}}</td>{{/if}}</tr>
          {{#if current.lifestyle}}<tr><td>{{sr2eT "SR2E.UI.lifestyle"}}</td><td colspan="2">{{current.lifestyle}}</td></tr>{{/if}}
        </tbody>
      </table>
      <h2 data-heading="Skills">{{sr2eT "SR2E.UI.skills"}}</h2>
      <table class="sr2e-current-table">
        <thead><tr><th></th><th>{{sr2eT "SR2E.UI.rating"}}</th><th></th>{{#if current.hasRecord}}<th>{{sr2eT "SR2E.UI.since"}}</th>{{/if}}</tr></thead>
        <tbody>
          {{#each current.skills}}<tr><td>{{name}} <span class="hint">{{kind}}</span></td><td><strong>{{rating}}</strong></td><td class="hint">{{extra}}</td>{{#if ../current.hasRecord}}<td class="sr2e-since">{{since}}</td>{{/if}}</tr>
          {{else}}<tr><td colspan="4"><em>{{sr2eT "SR2E.UI.noSkills"}}</em></td></tr>{{/each}}
        </tbody>
      </table>
      {{#if underway.length}}
      <h2 data-heading="Under way">{{sr2eT "SR2E.UI.underWay"}}</h2>
      <ul class="sr2e-list">{{#each underway}}<li><strong>{{label}}</strong> · {{left}}</li>{{/each}}</ul>
      {{/if}}
      <h2 data-heading="In effect">{{sr2eT "SR2E.UI.inEffect"}}</h2>
      <ul class="sr2e-list">
        {{#each current.effects}}<li><span class="hint">{{group}}:</span> <strong>{{name}}</strong>{{#if detail}} · {{detail}}{{/if}}{{#if until}} <span class="hint">({{until}})</span>{{/if}}</li>
        {{else}}<li><em>{{sr2eT "SR2E.UI.nothingIsActingOnRightNow" name=actor.name}}</em></li>{{/each}}
      </ul>
    </section>
  </section>
  {{/if}}
  <section class="tab sr2e-tab{{#if (eq activeTab "combat")}} active{{/if}}" data-group="primary" data-tab="combat">
    <section class="sr2e-items">
    <h2 data-heading="Weapons">{{sr2eT "SR2E.UI.weapons"}} <a class="sr2e-add" data-action="addItem" data-type="weapon" title="{{sr2eT "SR2E.UI.addWeapons"}}"><i class="fa-solid fa-plus"></i></a></h2>
    <ul>
      {{#each weapons}}
      <li{{#if leftBehind}} class="sr2e-left-behind"{{/if}}>
        {{#if @root.carriedOn}}<a class="sr2e-carried{{#if leftBehind}} off{{/if}}" data-action="toggleCarried" data-item-id="{{id}}" role="button" aria-pressed="{{#if leftBehind}}false{{else}}true{{/if}}" title="{{#if leftBehind}}{{sr2eT "SR2E.UI.leftBehindClickToCarry"}}{{else}}{{sr2eT "SR2E.UI.carriedClickToLeave"}}{{/if}}" aria-label="{{sr2eT "SR2E.UI.carried"}}"><i class="fa-solid fa-{{#if leftBehind}}box-archive{{else}}suitcase{{/if}}"></i></a>{{/if}}
        <a data-action="editItem" data-item-id="{{id}}">{{name}}</a>
