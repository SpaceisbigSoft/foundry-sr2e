    <div class="sr2e-row">
      <label class="sr2e-check"><input type="checkbox" data-token-opt="placed" checked> {{sr2eT "SR2E.UI.alsoTokensAlreadyOnScenes"}}</label>
      <label class="sr2e-check" title="{{sr2eT "SR2E.UI.anUnlinkedTokenKeepsItsOwn"}}"><input type="checkbox" data-token-opt="relink"> {{sr2eT "SR2E.UI.relinkUnlinkedOnes"}}</label>
    </div>
    <div class="sr2e-row"><button type="button" data-action="tokenParty"><i class="fa-solid fa-users"></i> {{sr2eT "SR2E.UI.thePartySTokens"}}</button>
      <button type="button" data-action="tokenPick"><i class="fa-solid fa-user-gear"></i> {{sr2eT "SR2E.UI.pickActors"}}</button></div>
  </section>

  <section class="sr2e-portraits">
    <h2 data-heading="Portraits by name">{{sr2eT "SR2E.UI.portraitsByName"}}</h2>
    {{#if portraitFolder}}
    <p class="hint">{{sr2eT "SR2E.UI.folder"}} <code>{{portraitFolder}}</code>{{sr2eT "SR2E.UI.aCharacterNamedRookTakes"}} <code>{{sr2eT "SR2E.UI.rookWebp" portraitFolder=portraitFolder}}</code> {{sr2eT "SR2E.UI.orPngJpgWhileItHas"}}</p>
    <div class="sr2e-row"><button type="button" data-action="findPortraits"><i class="fa-solid fa-image-portrait"></i> {{sr2eT "SR2E.UI.findPortraitsForEveryActor"}}</button></div>
    {{else}}
    <p class="hint">{{sr2eT "SR2E.UI.setA"}} <em>{{sr2eT "SR2E.UI.portraitFolder"}}</em> {{sr2eT "SR2E.UI.inConfigureSettingsSr2eToGive"}}</p>
    {{/if}}
  </section>

  <section class="sr2e-default-art">
    <h2 data-heading="Default token art">{{sr2eT "SR2E.UI.defaultTokenArt"}}</h2>
    <p class="hint">{{#if defaultArt.on}}{{sr2eT "SR2E.UI.newActorsGetTheSystemS"}} <em>{{sr2eT "SR2E.UI.defaultTokenArt"}}</em>).{{else}}{{sr2eT "SR2E.UI.offNewActorsKeepFoundryS"}} <em>{{sr2eT "SR2E.UI.defaultTokenArt"}}</em>).{{/if}} {{#if defaultArt.standIns}}{{sr2eT "SR2E.UI.actor" standIns=defaultArt.standIns}}{{#unless defaultArt.one}}s{{/unless}} {{sr2eT "SR2E.UI.stillShow"}}{{#if defaultArt.one}}s{{/if}} {{sr2eT "SR2E.UI.theStandInPictureOrToken"}}{{else}}{{sr2eT "SR2E.UI.noActorShowsTheStandIn"}}{{/if}}</p>
    {{#if defaultArt.standIns}}<div class="sr2e-row"><button type="button" data-action="defaultArtAll"><i class="fa-solid fa-image-portrait"></i> {{sr2eT "SR2E.UI.giveThemTheDefaultArt"}}</button></div>{{/if}}
  </section>

  <section class="sr2e-kits">
    <h2 data-heading="Starter kits">{{sr2eT "SR2E.UI.starterKits"}} <a data-action="kitNew" title="{{sr2eT "SR2E.UI.newKitFromTheItemsOn"}}"><i class="fa-solid fa-plus"></i></a> <a data-action="kitEmpty" title="{{sr2eT "SR2E.UI.newEmptyKitThenDropItems"}}"><i class="fa-solid fa-box-open"></i></a></h2>
    <p class="hint">{{sr2eT "SR2E.UI.aBundleOfItemsGivenIn"}}</p>
    <ul class="sr2e-list">
      {{#each kits}}
      <li data-kit-drop="{{id}}"><span><strong>{{name}}</strong> <span class="hint">{{sr2eT "SR2E.UI.line" count=count}}{{#unless (eq count 1)}}s{{/unless}}{{#if price}} · {{price}}{{/if}}{{#if unpriced}} {{sr2eT "SR2E.UI.unpriced" unpriced=unpriced}}{{/if}}</span><br><span class="hint">{{summary}}</span>{{#if notes}}<br><em>{{notes}}</em>{{/if}}</span>
        <span class="sr2e-gm-acts"><a data-action="kitGive" data-id="{{id}}" title="{{sr2eT "SR2E.UI.giveItToActors"}}"><i class="fa-solid fa-gift"></i></a>
          <a data-action="kitEdit" data-id="{{id}}" title="{{sr2eT "SR2E.UI.edit"}}"><i class="fa-solid fa-pen"></i></a>
          <a data-action="kitDelete" data-id="{{id}}" title="{{sr2eT "SR2E.UI.delete"}}"><i class="fa-solid fa-trash"></i></a></span></li>
      {{else}}<li><em>{{sr2eT "SR2E.UI.noKitsYetMakeOneFrom"}}</em></li>{{/each}}
    </ul>
  </section>

  <section class="sr2e-catalogue">
    <h2 data-heading="Item catalogue">{{sr2eT "SR2E.UI.itemCatalogue"}}</h2>
    <p class="hint">{{sr2eT "SR2E.UI.theWorldSItemTemplates" templateTotal=templateTotal}}{{#if templateCounts}}: {{templateCounts}}{{/if}}{{sr2eT "SR2E.UI.showFirstInEveryAddWindow"}}</p>
    <div class="sr2e-row">
      <button type="button" data-action="catPaste"><i class="fa-solid fa-table"></i> {{sr2eT "SR2E.UI.pasteSpreadsheetRows"}}</button>
      <button type="button" data-action="catCsv"><i class="fa-solid fa-file-csv"></i> {{sr2eT "SR2E.UI.exportAsCsv"}}</button>
      <button type="button" data-action="catList"><i class="fa-solid fa-list"></i> {{sr2eT "SR2E.UI.manageTemplates"}}</button>
      <button type="button" data-action="newEntry"><i class="fa-solid fa-file-circle-plus"></i> {{sr2eT "SR2E.UI.newEntryButton"}}</button>
    </div>
    <div class="sr2e-row">
      <button type="button" data-action="catExport"><i class="fa-solid fa-file-arrow-down"></i> {{sr2eT "SR2E.UI.saveACatalogueFile"}}</button>
      <button type="button" data-action="catImport"><i class="fa-solid fa-file-arrow-up"></i> {{sr2eT "SR2E.UI.loadACatalogueFile"}}</button>
    </div>
    <p class="hint">{{sr2eT "SR2E.UI.aCatalogueFileHoldsTheTemplates"}}</p>
    <p class="hint sr2e-warn">{{sr2eT "SR2E.UI.catalogueBookText"}}</p>
    <div class="sr2e-row">
      <button type="button" data-action="exportTemplates"><i class="fa-solid fa-file-export"></i> {{sr2eT "SR2E.UI.templatesToACompendium"}}</button>
      <button type="button" data-action="importTemplates"><i class="fa-solid fa-file-import"></i> {{sr2eT "SR2E.UI.templatesFromACompendium"}}</button>
    </div>
  </section>

  <section>
    <h2 data-heading="Characters from a stat block">{{sr2eT "SR2E.UI.charactersFromAStatBlock"}}</h2>
    <p class="hint">{{sr2eT "SR2E.UI.pasteACharacterWriteUpAttributes"}}</p>
    <button type="button" data-action="charImportNew"><i class="fa-solid fa-file-import"></i> {{sr2eT "SR2E.UI.newCharacterFromAStatBlock"}}</button>
  </section>

  <section>
    <h2 data-heading="Modules">{{sr2eT "SR2E.UI.modules"}}</h2>
    <ul class="sr2e-list">{{#each modules}}<li><strong>{{name}}</strong> <span class="hint">{{state}}</span><br><span class="hint">{{note}}</span></li>{{/each}}</ul>
    <p class="hint">{{sr2eT "SR2E.UI.alsoGoodWithSr2eNotSet"}}</p>
    <div class="sr2e-row"><button type="button" data-action="startTour" data-tour="gm-panel"><i class="fa-solid fa-person-chalkboard"></i> {{sr2eT "SR2E.UI.tourOfTheGmPanel"}}</button>
      <button type="button" data-action="openHelp"><i class="fa-solid fa-circle-question"></i> {{sr2eT "SR2E.UI.playerGuide"}}</button></div>
  </section>
  {{/with}}
  {{/if}}
</div>
