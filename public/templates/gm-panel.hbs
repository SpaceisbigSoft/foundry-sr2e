{{#*inline "personRow"}}
<li class="sr2e-gm-person{{#if current}} sr2e-current{{/if}}{{#if defeated}} sr2e-defeated{{/if}}{{#if @root.mookCards}}{{#if stat}} sr2e-mook{{/if}}{{/if}}">
  <div class="sr2e-row">
    {{#if tokenId}}<a data-action="panToken" data-token="{{tokenId}}" data-scene="{{sceneId}}" title="{{sr2eT "SR2E.UI.showAndSelectTheToken"}}"><i class="fa-solid fa-location-crosshairs"></i></a>{{/if}}
    {{#if initiative}}<span class="sr2e-init" title="{{sr2eT "SR2E.UI.initiative"}}">{{initiative}}</span>{{/if}}
    <a data-action="quick" data-act="sheet" data-uuid="{{uuid}}" title="{{sr2eT "SR2E.UI.openTheSheet"}}"><strong>{{name}}</strong></a>
    {{#if hurt}}<strong class="sr2e-warn">{{status}}</strong>{{/if}}{{#if defeated}} <em>{{sr2eT "SR2E.UI.defeated"}}</em>{{/if}}
  </div>
  {{!-- v0.68.0: the compact stat card's line (NPCs and grunts; the heading's toggle switches it off). --}}
  {{#if @root.mookCards}}{{#if stat}}
  <div class="sr2e-mook-stats" title="{{stat.text}}">
    {{#each stat.attrs}}<span class="sr2e-mook-attr" title="{{label}}"><b>{{k}}</b>{{v}}</span>{{/each}}
    <span class="sr2e-mook-sep" title="{{sr2eT "SR2E.UI.armorBallisticImpact2"}}"><b>{{sr2eT "SR2E.UI.arm"}}</b>{{stat.armor}}</span>
    <span class="sr2e-mook-sep" title="{{sr2eT "SR2E.UI.initiative"}}"><b>{{sr2eT "SR2E.UI.init"}}</b>{{stat.init}}</span>
    {{#if stat.pr}}<span class="sr2e-mook-sep" title="{{sr2eT "SR2E.UI.professionalRating"}}">{{stat.pr}}</span>{{/if}}
    {{#if stat.group}}<span class="sr2e-mook-sep" title="{{sr2eT "SR2E.UI.gruntsStandingInTheGroup"}}">{{stat.group}}</span>{{/if}}
    {{#each stat.weapons}}<span class="sr2e-mook-weapon" title="{{name}} {{damage}}"><b>{{name}}</b>{{damage}}</span>{{/each}}
  </div>
  {{/if}}{{/if}}
  <div class="sr2e-row sr2e-gm-line">
    {{#if monitor}}
    {{#if cm}}{{> "systems/sr2e/templates/monitor-mini.hbs"}}{{/if}}
    <span title="{{sr2eT "SR2E.UI.physicalBoxes"}}"><a data-action="box" data-uuid="{{uuid}}" data-track="physical" data-delta="-1" title="{{sr2eT "SR2E.UI.physical1"}}">−</a> P {{physical}} <a data-action="box" data-uuid="{{uuid}}" data-track="physical" data-delta="1" title="{{sr2eT "SR2E.UI.physical12"}}">+</a></span>
    <span title="{{sr2eT "SR2E.UI.stunBoxes"}}"><a data-action="box" data-uuid="{{uuid}}" data-track="stun" data-delta="-1" title="{{sr2eT "SR2E.UI.stun1"}}">−</a> S {{stun}} <a data-action="box" data-uuid="{{uuid}}" data-track="stun" data-delta="1" title="{{sr2eT "SR2E.UI.stun12"}}">+</a></span>
    {{/if}}
    {{#if condition}}<span>{{condition}}</span>{{/if}}
    <span class="sr2e-gm-acts">
      {{#if canAttack}}<a data-action="quick" data-act="quickAttack" data-uuid="{{uuid}}" title="{{sr2eT "SR2E.UI.attackTargetATokenFirst"}}"><i class="fa-solid fa-crosshairs"></i></a>{{/if}}
      {{#if canCast}}<a data-action="quick" data-act="quickCast" data-uuid="{{uuid}}" title="{{sr2eT "SR2E.UI.castASpell"}}"><i class="fa-solid fa-wand-sparkles"></i></a>{{/if}}
      {{#if canDefend}}<a data-action="quick" data-act="defend" data-uuid="{{uuid}}" title="{{sr2eT "SR2E.UI.defendAgainstTheNewestAttackOn"}}"><i class="fa-solid fa-shield-halved"></i></a>{{/if}}
      {{#if canPerceive}}<a data-action="quick" data-act="perceive" data-uuid="{{uuid}}" title="{{sr2eT "SR2E.UI.perceiveOpposed"}}"><i class="fa-solid fa-magnifying-glass"></i></a>{{/if}}
      {{#if canMorale}}<a data-action="quick" data-act="morale" data-uuid="{{uuid}}" title="{{sr2eT "SR2E.UI.moraleTest"}}"><i class="fa-solid fa-flag"></i></a>{{/if}}
      {{#if inCombat}}<a data-action="quick" data-act="init" data-uuid="{{uuid}}" title="{{sr2eT "SR2E.UI.rollInitiativeAgain"}}"><i class="fa-solid fa-dice"></i></a>{{/if}}
    </span>
  </div>
  {{#if pools}}<div class="hint">{{pools}}</div>{{/if}}
  {{#if chips}}<div class="hint"><em>{{chips}}</em></div>{{/if}}
</li>
{{/inline}}
<div class="sr2e-sheet sr2e-gm">
  <nav class="sr2e-tabs sr2e-gm-tabs">
    {{#each tabs}}<a data-action="gmTab" data-tab="{{id}}" class="{{#if active}}active{{/if}}" title="{{label}}"><i class="{{icon}}"></i> {{label}}{{#if count}} <span class="sr2e-badge">{{count}}</span>{{/if}}</a>{{/each}}
  </nav>
  <div class="sr2e-row sr2e-gm-undobar">
    <button type="button" data-action="undo" {{#unless undo.next}}disabled{{/unless}} title="{{#if undo.next}}{{sr2eT "SR2E.UI.undoCtrlShiftZ" next=undo.next}}{{else}}{{sr2eT "SR2E.UI.nothingToUndo"}}{{/if}}"><i class="fa-solid fa-rotate-left"></i> {{sr2eT "SR2E.UI.undo"}}</button>
    <span class="hint">{{#if undo.next}}{{undo.next}}{{else}}{{sr2eT "SR2E.UI.nothingToUndoYet"}}{{/if}}</span>
  </div>

  {{#if tab.scene}}
  <section>
    <h2 data-heading="Scene">{{sr2eT "SR2E.UI.scene"}}{{#if scene}}: {{scene.name}}{{/if}}</h2>
    {{#if scene}}
    <div class="sr2e-row">
      <label>{{sr2eT "SR2E.UI.backgroundCount"}} <input type="number" data-gm="background" value="{{scene.background}}" min="0"></label>
      <label>{{sr2eT "SR2E.UI.weather"}} <select data-gm="weather">{{#each scene.weather}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label title="{{sr2eT "SR2E.UI.drivingTestsOnThisSceneStart"}}">{{sr2eT "SR2E.UI.terrain"}} <select data-gm="terrain">{{#each scene.terrain}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>{{sr2eT "SR2E.UI.darkness"}} <input type="range" data-gm="darkness" value="{{scene.darkness}}" min="0" max="1" step="0.05"> <span>{{scene.darkness}}</span></label>
    </div>
    <div class="sr2e-row">
      <label class="sr2e-wide">{{sr2eT "SR2E.UI.environmentTags"}} <input type="text" data-gm="environment" value="{{scene.environment}}" placeholder="{{sr2eT "SR2E.UI.eGUrbanForestMountain"}}"></label>
    </div>
    <label>{{sr2eT "SR2E.UI.backgroundCountSourcesOnePerLine"}} <code>{{sr2eT "SR2E.UI.nameRatingAspectedToTagToxic"}}</code>)</label>
    <textarea data-gm="sources" rows="2" aria-label="{{sr2eT "SR2E.UI.backgroundCountSources"}}">{{scene.sources}}</textarea>
    {{else}}<p class="hint">{{sr2eT "SR2E.UI.noSceneIsBeingViewed"}}</p>{{/if}}
  </section>

  <section>
    <h2 data-heading="Regions with an SR2e environment">{{sr2eT "SR2E.UI.regionsWithAnSr2eEnvironment"}}</h2>
    <p class="hint">{{sr2eT "SR2E.UI.drawARegionOnTheMap"}} <em>{{sr2eT "SR2E.UI.sr2eEnvironment"}}</em> {{sr2eT "SR2E.UI.backgroundCountWeatherLightSmokeA"}}</p>
    <ul class="sr2e-list">
      {{#each regions}}
      <li><a data-action="openRegion" data-uuid="{{uuid}}" title="{{sr2eT "SR2E.UI.openTheRegionSConfig"}}"><strong>{{name}}</strong></a> <span class="hint">{{summary}}</span>{{#if inside}} <span>{{sr2eT "SR2E.UI.inside" inside=inside}}</span>{{/if}}</li>
      {{else}}<li><em>{{sr2eT "SR2E.UI.noneOnThisScene"}}</em></li>
      {{/each}}
    </ul>
  </section>
  <section>
    <h2 data-heading="Presets">{{sr2eT "SR2E.UI.presets"}} <a data-action="savePreset" title="{{sr2eT "SR2E.UI.saveThisSceneSConditionsAs"}}"><i class="fa-solid fa-floppy-disk"></i></a></h2>
    <ul class="sr2e-list">
      {{#each presets}}
      <li><a data-action="applyPreset" data-id="{{id}}" title="{{sr2eT "SR2E.UI.putTheseConditionsOnTheViewed"}}"><i class="fa-solid fa-play"></i> <strong>{{name}}</strong></a> <span class="hint">{{text}}</span>
        <a data-action="deletePreset" data-id="{{id}}" title="{{sr2eT "SR2E.UI.deleteThePreset"}}"><i class="fa-solid fa-trash"></i></a></li>
      {{else}}<li><em>{{sr2eT "SR2E.UI.noPresetsSetUpAScene"}}</em></li>
      {{/each}}
    </ul>
  </section>

  <section>
    <h2 data-heading="Time">{{sr2eT "SR2E.UI.time"}}</h2>
    <div class="sr2e-row">
      <span>{{sr2eT "SR2E.UI.worldTime"}} <strong>{{time.label}}</strong>{{#if time.combat}} · {{time.combat}}{{/if}}</span>
    </div>
    <div class="sr2e-row sr2e-gm-time">
      {{#each timeSteps}}<button type="button" data-action="advanceTime" data-seconds="{{seconds}}" title="{{title}}{{#if big}} {{sr2eT "SR2E.UI.asksFirst"}}{{/if}}">{{label}}</button>{{/each}}
    </div>
  </section>

  {{#if scene}}
  <section>
    <h2 data-heading="Encounter notes">{{sr2eT "SR2E.UI.encounterNotes"}}</h2>
    <textarea data-gm="notes" data-scene="{{sceneId}}" rows="4" placeholder="{{sr2eT "SR2E.UI.whoSHereWhatTheyWant"}}">{{notes}}</textarea>
    <p class="hint">{{sr2eT "SR2E.UI.playersDonTSeeTheseAnywhere"}}</p>
  </section>
  {{/if}}

  {{#if charges.length}}
  <section>
    <h2 data-heading="Charges on a timer">{{sr2eT "SR2E.UI.chargesOnATimer"}}</h2>
    <ul class="sr2e-list">
      {{#each charges}}
      <li><strong>{{name}}</strong> <span>{{sr2eT "SR2E.UI.power" power=power}}{{#if place}} {{sr2eT "SR2E.UI.on" place=place}}{{/if}} · {{#if left}}{{sr2eT "SR2E.UI.sLeft" left=left}}{{else}}{{sr2eT "SR2E.UI.due"}}{{/if}}{{#if round}} {{sr2eT "SR2E.UI.combatTurn" round=round}}{{/if}}</span>
        <a data-action="blowCharge" data-scene="{{sceneId}}" data-id="{{id}}" title="{{sr2eT "SR2E.UI.setItOffNow"}}"><i class="fa-solid fa-burst"></i></a>
        <a data-action="disarmTest" data-scene="{{sceneId}}" data-id="{{id}}" title="{{sr2eT "SR2E.UI.disarmTestTheSelectedTokenS" disarmTn=disarmTn}}"><i class="fa-solid fa-screwdriver-wrench"></i></a>
        <a data-action="disarmCharge" data-scene="{{sceneId}}" data-id="{{id}}" title="{{sr2eT "SR2E.UI.disarmRemoveItNoTest"}}"><i class="fa-solid fa-ban"></i></a></li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  <section>
    <h2 data-heading="Fires">{{sr2eT "SR2E.UI.fires"}} <a data-action="startFire" title="{{sr2eT "SR2E.UI.startAFireWhereTheSelected"}}"><i class="fa-solid fa-fire"></i></a>{{#if fires.length}} <a data-action="spreadFire" title="{{sr2eT "SR2E.UI.spreadEveryFireOneCombatTurn"}}"><i class="fa-solid fa-forward-step"></i></a>{{/if}}</h2>
    <ul class="sr2e-list">
      {{#each fires}}
      <li><a data-action="panFire" data-x="{{x}}" data-y="{{y}}" title="{{sr2eT "SR2E.UI.showIt"}}"><strong>{{source}}</strong></a> <span>{{#if burntOut}}{{sr2eT "SR2E.UI.smokeOnlyTurnSLeft" smokeLeft=smokeLeft}}{{else}}{{radius}} m · {{intensity}}{{#if fuel}} {{sr2eT "SR2E.UI.fuel" fuel=fuel}}{{/if}} {{sr2eT "SR2E.UI.turnS" turns=turns}}{{/if}}</span>
        <a data-action="putOutFire" data-scene="{{sceneId}}" data-id="{{id}}" title="{{#if burntOut}}{{sr2eT "SR2E.UI.clearTheSmoke"}}{{else}}{{sr2eT "SR2E.UI.putItOut"}}{{/if}}"><i class="fa-solid fa-fire-extinguisher"></i></a></li>
      {{else}}<li><em>{{sr2eT "SR2E.UI.noFiresOnThisScene"}}</em></li>
      {{/each}}
    </ul>
    <div class="form-group"><label>{{sr2eT "SR2E.UI.fuel2"}}</label><select data-gm="fuelKind" aria-label="{{sr2eT "SR2E.UI.fuel2"}}">{{#each fuelKinds}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      <a data-action="markFuel" title="{{sr2eT "SR2E.UI.markTheSelectedDrawingsAsThis"}}"><i class="fa-solid fa-gas-pump"></i> {{sr2eT "SR2E.UI.markSelectedDrawings"}}</a></div>
    <ul class="sr2e-list">
      {{#each fuel}}
      <li><a data-action="panFire" data-x="{{x}}" data-y="{{y}}" title="{{sr2eT "SR2E.UI.showIt"}}"><strong>{{label}}</strong></a> <span>{{status}}</span>
        <a data-action="clearFuel" data-id="{{id}}" title="{{sr2eT "SR2E.UI.notFuelAnyMore"}}"><i class="fa-solid fa-xmark"></i></a></li>
      {{/each}}
    </ul>
  </section>

  {{#if walls.length}}
  <section>
    <h2 data-heading="Damaged walls">{{sr2eT "SR2E.UI.damagedWalls"}}</h2>
    <ul class="sr2e-list">
      {{#each walls}}
      <li><a data-action="panWall" data-id="{{id}}" title="{{sr2eT "SR2E.UI.showIt"}}">{{sr2eT "SR2E.UI.wall" id=id}}</a> <span>{{sr2eT "SR2E.UI.ratingOf" rating=rating full=full}}{{#if breached}} · <strong class="sr2e-warn">{{sr2eT "SR2E.UI.breached"}}</strong>{{/if}}</span>
        <a data-action="repairWall" data-id="{{id}}" title="{{sr2eT "SR2E.UI.repairItFully"}}"><i class="fa-solid fa-trowel-bricks"></i></a>
        <a data-action="repairWallTest" data-id="{{id}}" title="{{sr2eT "SR2E.UI.aBuildRepairTest"}}"><i class="fa-solid fa-dice"></i></a></li>
      {{/each}}
    </ul>
  </section>
  {{/if}}
  {{/if}}

  {{#if tab.combat}}
  <section>
    {{#if combatInfo}}
    <h2 data-heading="Combat">{{sr2eT "SR2E.UI.combat"}}{{#if combatInfo.started}}{{sr2eT "SR2E.UI.combatTurnPass" round=combatInfo.round pass=combatInfo.pass}}{{else}} {{sr2eT "SR2E.UI.notStarted"}}{{/if}} <a data-action="toggleMookCards" class="sr2e-mook-toggle" title="{{#if mookCards}}{{sr2eT "SR2E.UI.showNpcsAsPlainRows"}}{{else}}{{sr2eT "SR2E.UI.showNpcsAsCompactStatCards"}}{{/if}}"><i class="fa-solid {{#if mookCards}}fa-list{{else}}fa-id-card{{/if}}"></i></a></h2>
    <p class="hint">{{#if combatInfo.current}}{{sr2eT "SR2E.UI.acting"}} <strong>{{combatInfo.current}}</strong> · {{/if}}{{sr2eT "SR2E.UI.inTheTurnOrder" count=combatInfo.count}}{{#if combatInfo.scene}} · {{combatInfo.scene}}{{/if}}</p>
    <div class="sr2e-row">
      {{#unless combatInfo.started}}<button type="button" data-action="combatStart"><i class="fa-solid fa-play"></i> {{sr2eT "SR2E.UI.start"}}</button>{{/unless}}
      <button type="button" data-action="combatPrev" title="{{sr2eT "SR2E.UI.backOneTurn"}}"><i class="fa-solid fa-backward-step"></i></button>
      <button type="button" data-action="combatNext" title="{{sr2eT "SR2E.UI.nextTurnNextPassNextCombat"}}"><i class="fa-solid fa-forward-step"></i> {{sr2eT "SR2E.UI.next"}}</button>
      <button type="button" data-action="combatRollNpc" title="{{sr2eT "SR2E.UI.rollInitiativeForEveryNpcThat"}}"><i class="fa-solid fa-dice"></i> {{sr2eT "SR2E.UI.rollNpcs"}}</button>
      <button type="button" data-action="combatAddSelected" title="{{sr2eT "SR2E.UI.addTheSelectedTokensToThis"}}"><i class="fa-solid fa-user-plus"></i> {{sr2eT "SR2E.UI.addSelected"}}</button>
    </div>
    <ul class="sr2e-list sr2e-gm-people">
      {{#each combatRows}}{{> personRow inCombat=true}}{{else}}<li><em>{{sr2eT "SR2E.UI.nobodyInTheCombatYet"}}</em></li>{{/each}}
    </ul>
    {{else}}
    <h2 data-heading="Combat">{{sr2eT "SR2E.UI.combat"}}</h2>
    <p class="hint">{{sr2eT "SR2E.UI.noCombatSelectTokensAndAdd"}}</p>
    <button type="button" data-action="combatAddSelected"><i class="fa-solid fa-user-plus"></i> {{sr2eT "SR2E.UI.addSelectedTokensToACombat"}}</button>
    {{/if}}
  </section>
  {{/if}}

  {{#if tab.party}}
  {{#if underway.length}}
  <section>
    <h2 data-heading="Under way">{{sr2eT "SR2E.UI.underWay"}}</h2>
    <ul class="sr2e-list sr2e-underway">
      {{#each underway}}<li class="{{#if due}}sr2e-due{{/if}}"><span><a data-action="openActor" data-uuid="{{uuid}}"><strong>{{actorName}}</strong></a> · {{label}} · {{left}}{{#if paid}} <span class="hint">{{sr2eT "SR2E.UI.paid" paid=paid}}</span>{{/if}}</span>
        <span class="sr2e-gm-acts"><a data-action="projectTimeGm" data-uuid="{{uuid}}" data-project-id="{{id}}" data-training="{{#if training}}1{{/if}}" title="{{sr2eT "SR2E.UI.changeTheTimeLeft"}}"><i class="fa-solid fa-hourglass-half"></i></a>
        <a data-action="projectFinishGm" data-uuid="{{uuid}}" data-project-id="{{id}}" data-training="{{#if training}}1{{/if}}" title="{{sr2eT "SR2E.UI.finishItNow"}}"><i class="fa-solid fa-forward-fast"></i></a></span></li>{{/each}}
    </ul>
    <p class="hint">{{sr2eT "SR2E.UI.learningBuildingRepairsOrdersAndTraining"}}</p>
  </section>
  {{/if}}
  <section>
    <h2 data-heading="Party">{{sr2eT "SR2E.UI.party2"}}</h2>
    {{!-- v0.68.0: the party as cards: portrait, player, monitor and ± boxes, wound TN, initiative, pools, money, state, quick buttons. --}}
    {{#if party.length}}
    <div class="sr2e-party-cards">
      {{#each party}}
      <article class="sr2e-party-card{{#if acting}} sr2e-acting{{/if}}{{#if hurt}} sr2e-hurt{{/if}}">
        <header class="sr2e-pc-head">
          <img class="sr2e-pc-portrait" src="{{img}}" alt="" loading="lazy">
          <div class="sr2e-pc-who">
            <a class="sr2e-pc-name" data-action="openActor" data-uuid="{{uuid}}" title="{{sr2eT "SR2E.UI.openTheSheet"}}">{{name}}</a>
            {{#if player}}<span class="sr2e-pc-player" title="{{sr2eT "SR2E.UI.player"}}">{{player}}</span>{{/if}}
          </div>
          {{#if initiative}}<span class="sr2e-pc-init" title="{{sr2eT "SR2E.UI.initiativeThisPass"}}{{#if acting}} {{sr2eT "SR2E.UI.actingNow"}}{{/if}}">{{initiative}}</span>{{/if}}
        </header>
        <div class="sr2e-pc-monitor">{{> "systems/sr2e/templates/monitor-mini.hbs"}}</div>
        <div class="sr2e-pc-boxes">
          <span class="sr2e-pc-track" title="{{sr2eT "SR2E.UI.physicalBoxes"}}"><a data-action="box" data-uuid="{{uuid}}" data-track="physical" data-delta="-1" title="{{sr2eT "SR2E.UI.physical1"}}">−</a> P <b>{{physical}}</b> <a data-action="box" data-uuid="{{uuid}}" data-track="physical" data-delta="1" title="{{sr2eT "SR2E.UI.physical12"}}">+</a></span>
          <span class="sr2e-pc-track" title="{{sr2eT "SR2E.UI.stunBoxes"}}"><a data-action="box" data-uuid="{{uuid}}" data-track="stun" data-delta="-1" title="{{sr2eT "SR2E.UI.stun1"}}">−</a> S <b>{{stun}}</b> <a data-action="box" data-uuid="{{uuid}}" data-track="stun" data-delta="1" title="{{sr2eT "SR2E.UI.stun12"}}">+</a></span>
          {{#if woundText}}<span class="sr2e-pc-wound" title="{{sr2eT "SR2E.UI.woundModifierToTargetNumbers"}}">{{woundText}}</span>{{/if}}
          {{#if hurt}}<strong class="sr2e-warn">{{statusText}}</strong>{{/if}}
        </div>
        {{#if poolChips.length}}<div class="sr2e-pc-pools">{{#each poolChips}}<span class="sr2e-pc-pool{{#if empty}} empty{{/if}}" title="{{title}}">{{label}} <b>{{text}}</b></span>{{/each}}</div>{{/if}}
        <div class="sr2e-pc-money"><span title="{{sr2eT "SR2E.UI.goodKarma"}}"><b>{{goodKarma}}</b> {{sr2eT "SR2E.UI.goodKarma"}}</span><span title="{{sr2eT "SR2E.UI.nuyen"}}"><b>{{nuyenText}}</b></span></div>
        {{#if state.length}}<div class="sr2e-pc-state">{{#each state}}<span class="sr2e-pc-chip">{{this}}</span>{{/each}}</div>{{/if}}
        {{#if chips.length}}<div class="sr2e-pc-chips">{{#each chips}}<span class="sr2e-pc-chip">{{this}}</span>{{/each}}</div>{{/if}}
        <footer class="sr2e-pc-acts">
          <a data-action="quick" data-act="sheet" data-uuid="{{uuid}}" title="{{sr2eT "SR2E.UI.openTheSheet"}}"><i class="fa-solid fa-id-badge"></i></a>
          {{#if tokenId}}<a data-action="panToken" data-token="{{tokenId}}" data-scene="{{sceneId}}" title="{{sr2eT "SR2E.UI.showAndSelectTheToken"}}"><i class="fa-solid fa-location-crosshairs"></i></a>{{/if}}
          {{#if inCombat}}<a data-action="quick" data-act="init" data-uuid="{{uuid}}" title="{{sr2eT "SR2E.UI.rollInitiativeAgain"}}"><i class="fa-solid fa-dice"></i></a>{{/if}}
        </footer>
      </article>
      {{/each}}
    </div>
    {{else}}<p><em>{{sr2eT "SR2E.UI.noPlayerCharacters"}}</em></p>{{/if}}
    <div class="sr2e-row">
      <button type="button" data-action="refreshPools" title="{{sr2eT "SR2E.UI.combatSpellHackingAndControlPools"}}">{{sr2eT "SR2E.UI.refreshPools"}}</button>
      <button type="button" data-action="refreshKarma">{{sr2eT "SR2E.UI.refreshKarmaPools"}}</button>
      <button type="button" data-action="award">{{sr2eT "SR2E.UI.awardKarmaNuyen"}}</button>
      <button type="button" data-action="healSeveral" title="{{sr2eT "SR2E.UI.takeBoxesOffSeveralPeopleAt"}}">{{sr2eT "SR2E.UI.healSeveral"}}</button>
    </div>
  </section>

  <section>
    <h2 data-heading="Money and Karma">{{sr2eT "SR2E.UI.moneyAndKarma"}}</h2>
    {{#if money.length}}
    <table class="sr2e-group sr2e-gm-money">
      <tr><th>{{sr2eT "SR2E.UI.who"}}</th><th>{{sr2eT "SR2E.UI.nuyen"}}</th><th>{{sr2eT "SR2E.UI.goodKarma"}}</th><th>{{sr2eT "SR2E.UI.karmaPool"}}</th><th>{{sr2eT "SR2E.UI.career"}}</th><th>{{sr2eT "SR2E.UI.lifestyle"}}</th></tr>
