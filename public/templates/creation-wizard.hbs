<div class="sr2e-sheet sr2e-wizard">
  {{#if finished}}
  <p>{{sr2eT "SR2E.UI.sCreationIsFinishedSeeThe" name=name}}</p>
  {{else}}
  <nav class="sr2e-wiz-steps" aria-label="{{sr2eT "SR2E.UI.steps"}}">
    {{#each steps}}<a data-action="wizStep" data-step="{{id}}" class="sr2e-wiz-step{{#if active}} active{{/if}} sr2e-wiz-{{state}}" title="{{hint}}"><span class="sr2e-wiz-n">{{n}}</span> {{label}}{{#if (eq state "bad")}} <i class="fa-solid fa-triangle-exclamation" aria-label="{{sr2eT "SR2E.UI.checkNotMet"}}"></i>{{/if}}{{#if (eq state "ok")}} <i class="fa-solid fa-check" aria-label="{{sr2eT "SR2E.UI.checksMet"}}"></i>{{/if}}</a>{{/each}}
  </nav>
  <div class="sr2e-wiz-main">
    <div class="sr2e-wiz-body">
      <h2 data-help="creation-wizard">{{n}}. {{label}}</h2>
      <p class="hint">{{hint}}</p>

      {{#if is.priorities}}
      <table class="sr2e-wiz-priorities">
        <thead><tr><th></th><th>A</th><th>B</th><th>C</th><th>D</th><th>E</th></tr></thead>
        <tbody>
          {{#each columns}}
          <tr><th scope="row">{{label}}</th>
            {{#each cells}}<td class="{{#if checked}}sr2e-picked{{/if}}"><label><input type="radio" name="wiz-{{../key}}" value="{{letter}}" data-wiz="priority" data-column="{{../key}}" {{checked checked}}> <span>{{text}}</span></label></td>{{/each}}
          </tr>
          {{/each}}
        </tbody>
      </table>
      <p class="hint">{{sr2eT "SR2E.UI.pickingALetterAnotherColumnHolds"}} {{#unless prioritiesDone}}<strong>{{sr2eT "SR2E.UI.giveEveryColumnADifferentLetter"}}</strong>{{/unless}}</p>
      {{/if}}

      {{#if is.metatype}}
      <ul class="sr2e-wiz-choices">
        {{#each metatypes}}
        <li class="{{#unless allowed}}sr2e-dim{{/unless}}"><label><input type="radio" name="wiz-metatype" value="{{key}}" data-wiz="metatype" {{checked selected}} {{#if @root.blocks}}{{#unless allowed}}{{#unless selected}}disabled{{/unless}}{{/unless}}{{/if}}> <strong>{{label}}</strong> <span class="hint">{{sr2eT "SR2E.UI.needsRaceOrBetter" need=need mods=mods}}</span></label></li>
        {{/each}}
      </ul>
      {{/if}}

      {{#if is.attributes}}
      <p><strong>{{points.used}}</strong> {{sr2eT "SR2E.UI.ofPoints" allowed=points.allowed}}{{#if points.left}} {{sr2eT "SR2E.UI.left2" left=points.left}}{{/if}}</p>
      <table class="sr2e-wiz-table">
        <thead><tr><th></th><th>{{sr2eT "SR2E.UI.base"}}</th><th>{{sr2eT "SR2E.UI.racial"}}</th><th>{{sr2eT "SR2E.UI.natural"}}</th></tr></thead>
        <tbody>
          {{#each attributes}}
          <tr><td>{{label}}</td><td><input type="number" class="sr2e-num" data-wiz="attribute" data-key="{{key}}" value="{{base}}" min="1"{{#if @root.blocks}} max="{{@root.attributeMax}}"{{/if}} aria-label="{{sr2eT "SR2E.UI.base5" label=label}}">{{#if over}} <span class="sr2e-warn" title="{{sr2eT "SR2E.UI.aboveCreationMax" max=@root.attributeMax}}">!</span>{{/if}}</td><td>{{#if racial}}{{racial}}{{else}}–{{/if}}</td><td>{{natural}}</td></tr>
          {{/each}}
        </tbody>
      </table>
      {{/if}}

      {{#if is.magic}}
      <ul class="sr2e-wiz-choices">
        {{#each magicKinds}}<li class="{{#unless allowed}}sr2e-dim{{/unless}}"><label><input type="radio" name="wiz-magic" value="{{key}}" data-wiz="magicKind" {{checked selected}} {{#if @root.blocks}}{{#unless allowed}}{{#unless selected}}disabled{{/unless}}{{/unless}}{{/if}}> {{label}}</label></li>{{/each}}
      </ul>
      {{#if showTraditions}}<div class="sr2e-row"><label>{{sr2eT "SR2E.UI.tradition"}} <select data-wiz="tradition">{{#each traditions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        {{#if isShaman}}<label>{{sr2eT "SR2E.UI.totem"}} <input type="text" data-wiz="totem" value="{{totem}}" placeholder="{{sr2eT "SR2E.UI.eGBear"}}"></label>{{/if}}</div>{{/if}}
      {{#unless (eq magicKind "none")}}<p>{{sr2eT "SR2E.UI.magic2"}} <strong>{{magicRating}}</strong>.</p>{{/unless}}
      {{#if castsSpells}}
      <h3 data-help="creation-wizard" data-heading="Spells">{{sr2eT "SR2E.UI.spells"}} <a class="sr2e-add" data-action="wizShop" data-type="spell" title="{{sr2eT "SR2E.UI.addSpellsTheAddWindow"}}"><i class="fa-solid fa-plus"></i></a></h3>
      {{#if spellPoints}}<p class="hint">{{sr2eT "SR2E.UI.spellPointsOf" used=spellPoints.used allowance=spellPoints.allowance}}{{#if spellPoints.note}} · {{spellPoints.note}}{{/if}}.</p>{{/if}}
      <ul class="sr2e-list">
        {{#each spells}}<li><a data-action="wizOpenItem" data-item-id="{{id}}">{{name}}</a> F<input type="number" class="sr2e-num" data-wiz="itemField" data-item-id="{{id}}" data-field="system.learnedForce" value="{{force}}" min="1" aria-label="{{sr2eT "SR2E.UI.force2" name=name}}"> <a data-action="wizDeleteItem" data-item-id="{{id}}" title="{{sr2eT "SR2E.UI.remove"}}"><i class="fa-solid fa-trash"></i></a></li>
        {{else}}<li><em>{{sr2eT "SR2E.UI.noSpellsYetTheOpensThe"}}</em></li>{{/each}}
      </ul>
      {{/if}}
      {{#if isAdept}}
      <h3 data-help="creation-wizard" data-heading="Adept powers">{{sr2eT "SR2E.UI.adeptPowers"}} <a class="sr2e-add" data-action="wizShop" data-type="adeptpower" title="{{sr2eT "SR2E.UI.addAdeptPowersTheAddWindow"}}"><i class="fa-solid fa-plus"></i></a></h3>
      <ul class="sr2e-list">
        {{#each powers}}<li><a data-action="wizOpenItem" data-item-id="{{id}}">{{name}}</a> {{sr2eT "SR2E.UI.level"}} <input type="number" class="sr2e-num" data-wiz="itemField" data-item-id="{{id}}" data-field="system.level" value="{{level}}" min="0" aria-label="{{sr2eT "SR2E.UI.level3" name=name}}"> {{sr2eT "SR2E.UI.pts" cost=cost}} <a data-action="wizDeleteItem" data-item-id="{{id}}" title="{{sr2eT "SR2E.UI.remove"}}"><i class="fa-solid fa-trash"></i></a></li>
        {{else}}<li><em>{{sr2eT "SR2E.UI.noPowersYetTheOpensThe"}}</em></li>{{/each}}
      </ul>
      {{/if}}
      {{/if}}

      {{#if is.skills}}
      {{#if specTrade}}<p class="hint">{{specTrade}}</p>{{/if}}
      {{#each skillGroups}}
      <h3 data-help="creation-wizard">{{label}} <a class="sr2e-add" data-action="wizAddSkill" data-kind="{{kind}}" title="{{sr2eT "SR2E.UI.addASkill2" label=label}}"><i class="fa-solid fa-plus"></i></a></h3>
      <ul class="sr2e-list">
        {{#each skills}}<li><span>{{name}}{{#if native}} <em>{{sr2eT "SR2E.UI.native"}}</em>{{/if}}</span> <input type="number" class="sr2e-num" data-wiz="itemField" data-item-id="{{id}}" data-field="system.rating" value="{{rating}}" min="0" aria-label="{{sr2eT "SR2E.UI.rating2" name=name}}">
          <input type="text" data-wiz="itemField" data-item-id="{{id}}" data-field="system.specialization" value="{{spec}}" placeholder="{{sr2eT "SR2E.UI.specialization"}}" aria-label="{{sr2eT "SR2E.UI.specialization2" name=name}}">{{#if spec}} <input type="number" class="sr2e-num" data-wiz="itemField" data-item-id="{{id}}" data-field="system.specializationRating" value="{{specRating}}" min="0" aria-label="{{sr2eT "SR2E.UI.specializationRating" name=name}}">{{/if}}
          {{#if paid}}<span class="hint{{#if paidBad}} sr2e-warning{{/if}}" title="{{#if paidBad}}{{paidBad}}{{else}}{{sr2eT "SR2E.UI.skillPointsPaidForThisSkill"}}{{/if}}">{{sr2eT "SR2E.UI.paid2" paid=paid}}{{#if paidBad}}: {{paidBad}}{{/if}}</span>{{/if}}
          <a data-action="wizDeleteItem" data-item-id="{{id}}" title="{{sr2eT "SR2E.UI.remove"}}"><i class="fa-solid fa-trash"></i></a></li>
        {{else}}<li><em>{{sr2eT "SR2E.UI.none4"}}</em></li>{{/each}}
      </ul>
      {{/each}}
      {{#if starters.length}}<p class="hint">{{sr2eT "SR2E.UI.commonSkillsNotTakenYetClick"}} {{#each starters}}<a data-action="wizAddStarter" data-name="{{name}}">{{label}}</a>{{#unless @last}}, {{/unless}}{{/each}}.</p>{{/if}}
      {{/if}}

      {{#if is.resources}}
      {{#if cash}}
      <p>{{sr2eT "SR2E.UI.resources"}} <strong>¥{{allowance}}</strong>{{sr2eT "SR2E.UI.gearLifestyleContacts" gearCost=gearCost lifeCost=lifeCost contactsCost=contactsCost}}{{#if spellPoints.extraNuyen}} {{sr2eT "SR2E.UI.extraSpellPoints" extraSpell=extraSpell}}{{/if}} · <strong>{{sr2eT "SR2E.UI.cash" cash=cash}}</strong>.</p>
      {{#if leftover}}<p class="hint">{{leftover}}</p>{{/if}}
      {{else}}<p class="sr2e-warning">{{sr2eT "SR2E.UI.giveResourcesAPriorityFirstStep"}}</p>{{/if}}
      <div class="sr2e-row">
        <label>{{sr2eT "SR2E.UI.lifestyle"}} <select data-wiz="lifestyle">{{#each lifestyles}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label>{{sr2eT "SR2E.UI.monthsPaidAhead"}} <input type="number" class="sr2e-num" data-wiz="months" value="{{months}}" min="1" {{#if outright}}disabled{{/if}}></label>
        <label title="{{sr2eT "SR2E.UI.payMonthsNowItIsTheirs" outrightMonths=outrightMonths}}"><input type="checkbox" data-wiz="outright" {{checked outright}}> {{sr2eT "SR2E.UI.buyItOutright"}}</label>
      </div>
      {{#if suggested}}<p class="hint">{{sr2eT "SR2E.UI.theResourcesPrioritySuggestsALifestyle" suggested=suggested}}</p>{{/if}}
      <h3 data-heading="Shopping">{{sr2eT "SR2E.UI.shopping"}}</h3>
      <div class="sr2e-row sr2e-wiz-shops">{{#each shops}}<button type="button" data-action="wizShop" data-type="{{type}}"><i class="fa-solid fa-cart-shopping"></i> {{label}}</button>{{/each}}</div>
      <p class="hint">{{sr2eT "SR2E.UI.theAddWindowListsTheGm"}}</p>
      <ul class="sr2e-list">
        {{#each bought}}<li><a data-action="wizOpenItem" data-item-id="{{id}}">{{name}}</a>{{#if (gt qty 1)}} ×{{qty}}{{/if}} <span class="hint">{{type}} · {{cost}}{{#if essence}} {{sr2eT "SR2E.UI.essence4" essence=essence}}{{/if}}</span> <a data-action="wizDeleteItem" data-item-id="{{id}}" title="{{sr2eT "SR2E.UI.removeTheNuyenComesBack"}}"><i class="fa-solid fa-trash"></i></a></li>
        {{else}}<li><em>{{sr2eT "SR2E.UI.nothingBoughtYet"}}</em></li>{{/each}}
      </ul>
      <p>{{sr2eT "SR2E.UI.essence"}} <strong>{{essence}}</strong></p>
      {{/if}}

      {{#if is.contacts}}
      <p class="hint">{{sr2eT "SR2E.UI.theFirstContact" freeContacts=freeContacts}}{{#unless (eq freeContacts 1)}}s{{/unless}} {{sr2eT "SR2E.UI.areFreeAsLevel1Contacts" contactsCost=contactsCost}}</p>
      <ul class="sr2e-list sr2e-wiz-contacts">
        {{#each contacts}}<li><input type="text" data-wiz="contact" data-id="{{id}}" data-field="name" value="{{name}}" aria-label="{{sr2eT "SR2E.UI.contactName"}}">
          <label>{{sr2eT "SR2E.UI.level2"}} <input type="number" class="sr2e-num" data-wiz="contact" data-id="{{id}}" data-field="level" value="{{level}}" min="1" max="3"></label>
          <input type="text" data-wiz="contact" data-id="{{id}}" data-field="role" value="{{role}}" placeholder="{{sr2eT "SR2E.UI.roleEGFixer"}}" aria-label="{{sr2eT "SR2E.UI.role"}}">
          <a data-action="wizDeleteContact" data-id="{{id}}" title="{{sr2eT "SR2E.UI.remove"}}"><i class="fa-solid fa-trash"></i></a></li>
        {{else}}<li><em>{{sr2eT "SR2E.UI.noContactsYet"}}</em></li>{{/each}}
      </ul>
      <p><button type="button" data-action="wizAddContact"><i class="fa-solid fa-plus"></i> {{sr2eT "SR2E.UI.addAContact"}}</button></p>
      {{/if}}

      {{#if is.review}}
      <table class="sr2e-build">
        <thead><tr><th>{{sr2eT "SR2E.UI.check2"}}</th><th>{{sr2eT "SR2E.UI.used"}}</th><th>{{sr2eT "SR2E.UI.allowed"}}</th><th></th></tr></thead>
        <tbody>{{#each checks}}<tr class="{{#unless ok}}sr2e-warning{{/unless}}"><td><a data-action="wizStep" data-step="{{stepId}}">{{#if ok}}✓{{else}}✗{{/if}} {{label}}</a></td><td>{{used}}</td><td>{{allowed}}</td><td>{{note}}</td></tr>{{/each}}</tbody>
      </table>
      {{#if cash}}<p>{{sr2eT "SR2E.UI.cashAtTheStart"}} <strong>¥{{cash}}</strong>{{#if leftover}} ({{leftover}}){{/if}}.</p>{{/if}}
      <p>{{#if failed}}<strong class="sr2e-warn">{{sr2eT "SR2E.UI.check3" failed=failed}}{{#unless (eq failed 1)}}s{{/unless}} {{sr2eT "SR2E.UI.notMet2"}}</strong> {{sr2eT "SR2E.UI.youCanStillFinishTheRecord"}}{{else}}{{sr2eT "SR2E.UI.everyCheckIsMet"}}{{/if}}</p>
      <p><button type="button" class="sr2e-wiz-finish" data-action="wizFinish"><i class="fa-solid fa-flag-checkered"></i> {{sr2eT "SR2E.UI.finishCreation"}}</button></p>
      <p class="hint">{{sr2eT "SR2E.UI.finishingFreezesTheCreationTabS"}} <a data-action="wizQuickBuild">{{sr2eT "SR2E.UI.quickBuildFromTypedLists"}}</a> {{sr2eT "SR2E.UI.theOldBuildWindowIsStill"}}</p>
      {{/if}}
    </div>
    <aside class="sr2e-wiz-totals" aria-label="{{sr2eT "SR2E.UI.runningTotals"}}">
      <h3 data-heading="Totals">{{sr2eT "SR2E.UI.totals"}}</h3>
      <ul>
        {{#each checks}}<li class="{{#unless ok}}sr2e-warn{{/unless}}{{#if here}} sr2e-here{{/if}}" title="{{note}}">{{#if ok}}✓{{else}}✗{{/if}} {{label}} <span>{{used}} / {{allowed}}</span></li>{{/each}}
      </ul>
    </aside>
  </div>
  <footer class="sr2e-wiz-foot">
    <button type="button" data-action="wizBack" {{#if first}}disabled{{/if}}><i class="fa-solid fa-arrow-left"></i> {{sr2eT "SR2E.UI.back"}}</button>
    <span class="hint">{{sr2eT "SR2E.UI.stepOf" n=n total=total}}</span>
    {{#if last}}<button type="button" data-action="wizFinish"><i class="fa-solid fa-flag-checkered"></i> {{sr2eT "SR2E.UI.finishCreation"}}</button>{{else}}<button type="button" data-action="wizNext">{{sr2eT "SR2E.UI.next"}} <i class="fa-solid fa-arrow-right"></i></button>{{/if}}
  </footer>
  {{/if}}
</div>
