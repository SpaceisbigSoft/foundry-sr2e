{
  "name": "sr2e",
  "version": "0.92.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --outDir public --emptyOutDir false && node scripts/minify.mjs",
    "dev": "vite build --outDir public --emptyOutDir false --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./src/module/__tests__/helpers/english-lang.ts --test \"src/**/__tests__/*.test.ts\"",
    "packs": "node scripts/build-packs.mjs",
    "tokens": "tsx scripts/build-tokens.ts",
    "backdrops": "tsx scripts/build-backdrops.ts",
    "cover": "tsx scripts/build-cover.ts"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.5",
    "@types/node": "^24.10.0",
    "esbuild": "~0.28.2",
    "handlebars": "^4.7.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.4"
  }
}
